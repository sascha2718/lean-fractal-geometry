module

/-
The algebraic part of the proof of `prop:ssc_no_overlap_not_pesc` in
`sec:exponential_separation`: the choice of algebraically independent parameters (tex lines
1429 to 1443) and the freeness of the semigroup generated by the eight maps of the projective
system (tex lines 1407 to 1436). The module `BoxLike.NoOverlapExample` applies it to the system.

The eleven parameters are indexed by `Fin 11` in the order
`(r_1, r_2, r_3, r_4, r_5, q, u, v, s_1, s_2, s_3)`.

* `homTrans`, `homWord`, `homWord_apply`, `HomFree`, `HomFree.eq_of_length_eq`: the homogeneous
  system `(λx, λx + t, λx + 1)`, its compositions, and the statement that it generates a free
  semigroup.
* `genRatio`, `genTrans`, `genDeriv`, `genVal`: the ratio and the translation of the eight maps
  `g_p`, and the derivative and the value at `0` of `g_𝐣`, as polynomial functions of the
  parameters with values in an arbitrary commutative ring.
* `map_genDeriv`, `map_genVal`: these functions commute with ring homomorphisms.
* `genDeriv_transfer`, `genVal_transfer`: an identity between two words that holds at a tuple
  algebraically independent over a subfield `K ∋ λ, t` of `ℝ` holds at every real tuple.
* `lamSym`, `slot`, `exists_lamSym_prefix`, `genDeriv_special`, `genVal_special`: the first symbol
  of a word that is not one of the three `λ`-symbols, and the values of a word at a tuple with
  `r_1 = ⋯ = r_5 = q = 0`.
* `eq_of_genDeriv_eq_of_genVal_eq`: at an algebraically independent tuple two words with the
  same derivative and the same value at `0` are equal.
* `exists_transcendental_mem_Ioo`, `countable_closure`, `exists_algebraicIndependent_mem_Ioo`:
  every box of non-empty open intervals contains a tuple algebraically independent over a
  countable subfield of `ℝ`.
-/
public import BoxLike.System
public import Mathlib.Algebra.AlgebraicCard
public import Mathlib.Algebra.FreeAlgebra.Cardinality
public import Mathlib.Analysis.Real.Cardinality
public import Mathlib.RingTheory.AlgebraicIndependent.Transcendental
public import Mathlib.SetTheory.Cardinal.Subfield

@[expose] public section

namespace BoxLike

namespace NoOverlap

open MvPolynomial

/-! ### The homogeneous three-map system -/

/-- The translations `0, t, 1` of the homogeneous system `(λx, λx + t, λx + 1)` in the proof of
`prop:ssc_no_overlap_not_pesc`. -/
def homTrans (t : ℝ) : Fin 3 → ℝ := ![0, t, 1]

/-- The composition `h_𝐢 = h_{i_0} ∘ ⋯ ∘ h_{i_{n-1}}` of the maps `h_0(x) = λx`,
`h_1(x) = λx + t` and `h_2(x) = λx + 1` of `prop:ssc_no_overlap_not_pesc`. -/
def homWord (lam t : ℝ) : List (Fin 3) → ℝ → ℝ
  | [] => id
  | i :: w => (fun x => lam * x + homTrans t i) ∘ homWord lam t w

/-- The empty word gives the identity. -/
@[simp] theorem homWord_nil (lam t : ℝ) : homWord lam t [] = id := rfl

/-- `h_{i𝐢}(x) = λ h_𝐢(x) + h_i(0)`. -/
@[simp] theorem homWord_cons (lam t : ℝ) (i : Fin 3) (w : List (Fin 3)) (x : ℝ) :
    homWord lam t (i :: w) x = lam * homWord lam t w x + homTrans t i := rfl

/-- `h_𝐢` is affine with slope `λ^{|𝐢|}`. -/
theorem homWord_apply (lam t : ℝ) (w : List (Fin 3)) (x : ℝ) :
    homWord lam t w x = lam ^ w.length * x + homWord lam t w 0 := by
  induction w with
  | nil => simp
  | cons i w ih =>
    rw [homWord_cons, homWord_cons, ih, List.length_cons]
    ring

/-- The homogeneous system `(λx, λx + t, λx + 1)` generates a free semigroup, as in
`prop:ssc_no_overlap_not_pesc`: distinct finite words give distinct maps. For `0 < λ < 1` this
says that `(λ, t)` lies outside the exact overlapping set `ℰ` of Bárány and Käenmäki; the empty
word changes nothing, since `h_𝐢` has slope `λ^{|𝐢|} ≠ 1` for every non-empty word. -/
def HomFree (lam t : ℝ) : Prop := Function.Injective (homWord lam t)

/-- In a free homogeneous system two words of the same length with `h_𝐢(0) = h_𝐣(0)` are equal,
since the maps `h_𝐢` and `h_𝐣` have the same slope. -/
theorem HomFree.eq_of_length_eq {lam t : ℝ} (h : HomFree lam t) {w w' : List (Fin 3)}
    (hlen : w.length = w'.length) (h0 : homWord lam t w 0 = homWord lam t w' 0) : w = w' := by
  apply h
  funext x
  rw [homWord_apply, homWord_apply lam t w', hlen, h0]

/-! ### The eight maps as functions of the parameters -/

section Generic

variable {A B : Type*} [CommRing A] [CommRing B]

/-- The ratio of the map `g_p` of the projective system of `prop:ssc_no_overlap_not_pesc` as a
function of `λ` and of the parameters: `λ, λ, λ, r_4` on the first axis and `r_1, r_2, r_3, r_5`
on the second axis. -/
def genRatio (l : A) (θ : Fin 11 → A) (p : Fin 4 × ZMod 2) : A :=
  if p.2 = 0 then ![l, l, l, θ 3] p.1 else ![θ 0, θ 1, θ 2, θ 4] p.1

/-- The translation of the map `g_p` of the projective system of
`prop:ssc_no_overlap_not_pesc` as a function of `t` and of the parameters: `q, q + t, q + 1, u`
on the first axis and `s_1, s_2, s_3, v` on the second axis. -/
def genTrans (τ : A) (θ : Fin 11 → A) (p : Fin 4 × ZMod 2) : A :=
  if p.2 = 0 then ![θ 5, θ 5 + τ, θ 5 + 1, θ 6] p.1 else ![θ 8, θ 9, θ 10, θ 7] p.1

/-- The derivative of `g_𝐣` as a function of the parameters. -/
def genDeriv (l : A) (θ : Fin 11 → A) : List (Fin 4 × ZMod 2) → A
  | [] => 1
  | p :: u => genRatio l θ p * genDeriv l θ u

/-- The value `g_𝐣(0)` as a function of the parameters. -/
def genVal (l τ : A) (θ : Fin 11 → A) : List (Fin 4 × ZMod 2) → A
  | [] => 0
  | p :: u => genRatio l θ p * genVal l τ θ u + genTrans τ θ p

/-- The empty word has derivative `1`. -/
@[simp] theorem genDeriv_nil (l : A) (θ : Fin 11 → A) : genDeriv l θ [] = 1 := rfl

/-- `g_{p𝐣}' = g_p' g_𝐣'`. -/
@[simp] theorem genDeriv_cons (l : A) (θ : Fin 11 → A) (p : Fin 4 × ZMod 2)
    (u : List (Fin 4 × ZMod 2)) :
    genDeriv l θ (p :: u) = genRatio l θ p * genDeriv l θ u := rfl

/-- The empty word gives the identity, with value `0` at `0`. -/
@[simp] theorem genVal_nil (l τ : A) (θ : Fin 11 → A) : genVal l τ θ [] = 0 := rfl

/-- `g_{p𝐣}(0) = g_p' g_𝐣(0) + g_p(0)`. -/
@[simp] theorem genVal_cons (l τ : A) (θ : Fin 11 → A) (p : Fin 4 × ZMod 2)
    (u : List (Fin 4 × ZMod 2)) :
    genVal l τ θ (p :: u) = genRatio l θ p * genVal l τ θ u + genTrans τ θ p := rfl

/-- The derivative of a composition is the product of the derivatives. -/
theorem genDeriv_append (l : A) (θ : Fin 11 → A) (u u' : List (Fin 4 × ZMod 2)) :
    genDeriv l θ (u ++ u') = genDeriv l θ u * genDeriv l θ u' := by
  induction u with
  | nil => simp
  | cons p u ih => simp [ih, mul_assoc]

/-- `g_{𝐣𝐣'}(0) = g_𝐣' g_{𝐣'}(0) + g_𝐣(0)`. -/
theorem genVal_append (l τ : A) (θ : Fin 11 → A) (u u' : List (Fin 4 × ZMod 2)) :
    genVal l τ θ (u ++ u') = genDeriv l θ u * genVal l τ θ u' + genVal l τ θ u := by
  induction u with
  | nil => simp
  | cons p u ih => simp [ih]; ring

/-- The ratio of `g_p` commutes with ring homomorphisms. -/
theorem map_genRatio {F : Type*} [FunLike F A B] [RingHomClass F A B] (f : F) (l : A)
    (θ : Fin 11 → A) (p : Fin 4 × ZMod 2) :
    f (genRatio l θ p) = genRatio (f l) (f ∘ θ) p := by
  obtain ⟨i, c⟩ := p
  fin_cases i <;> rcases zmod_two_cases c with rfl | rfl <;> simp [genRatio]

/-- The translation of `g_p` commutes with ring homomorphisms. -/
theorem map_genTrans {F : Type*} [FunLike F A B] [RingHomClass F A B] (f : F) (τ : A)
    (θ : Fin 11 → A) (p : Fin 4 × ZMod 2) :
    f (genTrans τ θ p) = genTrans (f τ) (f ∘ θ) p := by
  obtain ⟨i, c⟩ := p
  fin_cases i <;> rcases zmod_two_cases c with rfl | rfl <;> simp [genTrans]

/-- The derivative of `g_𝐣` commutes with ring homomorphisms. -/
theorem map_genDeriv {F : Type*} [FunLike F A B] [RingHomClass F A B] (f : F) (l : A)
    (θ : Fin 11 → A) (u : List (Fin 4 × ZMod 2)) :
    f (genDeriv l θ u) = genDeriv (f l) (f ∘ θ) u := by
  induction u with
  | nil => simp
  | cons p u ih => simp [ih, map_genRatio]

/-- The value `g_𝐣(0)` commutes with ring homomorphisms. -/
theorem map_genVal {F : Type*} [FunLike F A B] [RingHomClass F A B] (f : F) (l τ : A)
    (θ : Fin 11 → A) (u : List (Fin 4 × ZMod 2)) :
    f (genVal l τ θ u) = genVal (f l) (f τ) (f ∘ θ) u := by
  induction u with
  | nil => simp
  | cons p u ih => simp [ih, map_genRatio, map_genTrans]

end Generic

/-! ### Identities at an algebraically independent tuple hold at every tuple -/

section Transfer

variable {K : Subfield ℝ} {lam t : ℝ} {x : Fin 11 → ℝ}

/-- The identity `g_𝐢' = g_𝐣'` is a polynomial identity in the parameters over `K ∋ λ` (tex
lines 1486 to 1488): if it holds at a tuple `x` algebraically independent over `K`, then it
holds at every real tuple `θ`. -/
theorem genDeriv_transfer (hlam : lam ∈ K) (hx : AlgebraicIndependent K x)
    {u u' : List (Fin 4 × ZMod 2)} (h : genDeriv lam x u = genDeriv lam x u')
    (θ : Fin 11 → ℝ) : genDeriv lam θ u = genDeriv lam θ u' := by
  have key : ∀ (θ : Fin 11 → ℝ) (u : List (Fin 4 × ZMod 2)),
      aeval θ (genDeriv (C (⟨lam, hlam⟩ : K)) (X : Fin 11 → MvPolynomial (Fin 11) K) u) =
        genDeriv lam θ u := by
    intro θ u
    rw [map_genDeriv]
    congr 1
    · rw [aeval_C]; rfl
    · funext k; simp
  have hP := hx (a₁ := genDeriv (C (⟨lam, hlam⟩ : K)) X u)
    (a₂ := genDeriv (C (⟨lam, hlam⟩ : K)) X u') (by rw [key, key, h])
  rw [← key, ← key, hP]

/-- The identity `g_𝐢(0) = g_𝐣(0)` is a polynomial identity in the parameters over `K ∋ λ, t`
(tex lines 1423 to 1425): if it holds at a tuple `x` algebraically independent over `K`, then
it holds at every real tuple `θ`. -/
theorem genVal_transfer (hlam : lam ∈ K) (ht : t ∈ K) (hx : AlgebraicIndependent K x)
    {u u' : List (Fin 4 × ZMod 2)} (h : genVal lam t x u = genVal lam t x u')
    (θ : Fin 11 → ℝ) : genVal lam t θ u = genVal lam t θ u' := by
  have key : ∀ (θ : Fin 11 → ℝ) (u : List (Fin 4 × ZMod 2)),
      aeval θ (genVal (C (⟨lam, hlam⟩ : K)) (C (⟨t, ht⟩ : K))
        (X : Fin 11 → MvPolynomial (Fin 11) K) u) = genVal lam t θ u := by
    intro θ u
    rw [map_genVal]
    congr 1
    · rw [aeval_C]; rfl
    · rw [aeval_C]; rfl
    · funext k; simp
  have hP := hx (a₁ := genVal (C (⟨lam, hlam⟩ : K)) (C (⟨t, ht⟩ : K)) X u)
    (a₂ := genVal (C (⟨lam, hlam⟩ : K)) (C (⟨t, ht⟩ : K)) X u') (by rw [key, key, h])
  rw [← key, ← key, hP]

end Transfer

/-! ### The first symbol that is not a `λ`-symbol -/

section Special

/-- The symbols `1, 2, 3` of the three maps `g_1, g_2, g_3` with ratio `λ` (tex line 1391). -/
def lamSym (i : Fin 3) : Fin 4 × ZMod 2 := (i.castSucc, 0)

/-- The index of the translation parameter of a symbol that is not a `λ`-symbol: `u` for
`g_4`, `s_1, s_2, s_3` for `g_5, g_6, g_7` and `v` for `g_8` (tex lines 1409 to 1410). -/
def slot (p : Fin 4 × ZMod 2) : Fin 11 := if p.2 = 0 then 6 else ![8, 9, 10, 7] p.1

/-- Distinct symbols outside the `λ`-symbols have distinct translation parameters. -/
theorem slot_injOn : ∀ p p' : Fin 4 × ZMod 2, (∀ i, p ≠ lamSym i) → (∀ i, p' ≠ lamSym i) →
    slot p = slot p' → p = p' := by
  decide

/-- The translation parameters `u, v, s_1, s_2, s_3` come after `r_1, …, r_5, q`. -/
theorem six_le_slot : ∀ p : Fin 4 × ZMod 2, 6 ≤ (slot p : ℕ) := by
  decide

/-- The decomposition `𝐢 = 𝐤 j 𝐥` of tex lines 1418 to 1423: every word is a word `𝐤` of
`λ`-symbols followed by the empty word or by a word `j 𝐥` whose first symbol is not a
`λ`-symbol. -/
theorem exists_lamSym_prefix (u : List (Fin 4 × ZMod 2)) :
    ∃ (w : List (Fin 3)) (rest : List (Fin 4 × ZMod 2)), u = w.map lamSym ++ rest ∧
      (rest = [] ∨ ∃ j l, (∀ i, j ≠ lamSym i) ∧ rest = j :: l) := by
  induction u with
  | nil => exact ⟨[], [], rfl, Or.inl rfl⟩
  | cons p u ih =>
    by_cases hp : ∃ i, p = lamSym i
    · obtain ⟨i, rfl⟩ := hp
      obtain ⟨w, rest, rfl, hrest⟩ := ih
      exact ⟨i :: w, rest, rfl, hrest⟩
    · exact ⟨[], p :: u, rfl, Or.inr ⟨p, u, fun i h => hp ⟨i, h⟩, rfl⟩⟩

/-- The tuple `θ` has `r_1 = ⋯ = r_5 = q = 0`. Evaluation at such a tuple keeps the terms of
`g_𝐣(0)` with no factor from `r_1, …, r_5` (tex lines 1425 to 1429). -/
def Special (θ : Fin 11 → ℝ) : Prop := ∀ k : Fin 11, (k : ℕ) < 6 → θ k = 0

variable {lam t : ℝ} {θ : Fin 11 → ℝ}

/-- The zero tuple has `r_1 = ⋯ = r_5 = q = 0`. -/
theorem special_zero : Special 0 := fun _ _ => rfl

/-- The tuple with one translation parameter among `u, v, s_1, s_2, s_3` equal to `1` and all
other parameters equal to `0` has `r_1 = ⋯ = r_5 = q = 0`. -/
theorem special_single (p : Fin 4 × ZMod 2) : Special (Pi.single (slot p) 1) := by
  intro k hk
  refine Pi.single_eq_of_ne (fun h => ?_) _
  have := six_le_slot p
  rw [← h] at this
  omega

/-- The maps `g_1, g_2, g_3` have ratio `λ`. -/
theorem genRatio_lamSym (i : Fin 3) : genRatio lam θ (lamSym i) = lam := by
  fin_cases i <;> simp [genRatio, lamSym]

/-- At `q = 0` the maps `g_1, g_2, g_3` have the translations `0, t, 1` of the homogeneous
system. -/
theorem genTrans_lamSym (hθ : Special θ) (i : Fin 3) :
    genTrans t θ (lamSym i) = homTrans t i := by
  have h5 := hθ 5 (by decide)
  fin_cases i <;> simp [genTrans, lamSym, homTrans, h5]

/-- At `r_1 = ⋯ = r_5 = 0` the maps `g_4, …, g_8` have ratio `0`. -/
theorem genRatio_of_ne (hθ : Special θ) {p : Fin 4 × ZMod 2} (hp : ∀ i, p ≠ lamSym i) :
    genRatio lam θ p = 0 := by
  have h0 := hθ 0 (by decide)
  have h1 := hθ 1 (by decide)
  have h2 := hθ 2 (by decide)
  have h3 := hθ 3 (by decide)
  have h4 := hθ 4 (by decide)
  obtain ⟨i, c⟩ := p
  fin_cases i <;> rcases zmod_two_cases c with rfl | rfl <;>
    first
    | exact absurd rfl (hp 0)
    | exact absurd rfl (hp 1)
    | exact absurd rfl (hp 2)
    | simp [genRatio, h0, h1, h2, h3, h4]

/-- The translation of each of the maps `g_4, …, g_8` is one of the parameters
`u, s_1, s_2, s_3, v`. -/
theorem genTrans_of_ne {p : Fin 4 × ZMod 2} (hp : ∀ i, p ≠ lamSym i) :
    genTrans t θ p = θ (slot p) := by
  obtain ⟨i, c⟩ := p
  fin_cases i <;> rcases zmod_two_cases c with rfl | rfl <;>
    first
    | exact absurd rfl (hp 0)
    | exact absurd rfl (hp 1)
    | exact absurd rfl (hp 2)
    | simp [genTrans, slot]

/-- A word of `n` symbols among `1, 2, 3` has derivative `λ^n`. -/
theorem genDeriv_map_lamSym (w : List (Fin 3)) :
    genDeriv lam θ (w.map lamSym) = lam ^ w.length := by
  induction w with
  | nil => simp
  | cons i w ih => simp [ih, genRatio_lamSym, pow_succ']

/-- At `q = 0` the maps `g_1, g_2, g_3` are the maps of the homogeneous system. -/
theorem genVal_map_lamSym (hθ : Special θ) (w : List (Fin 3)) :
    genVal lam t θ (w.map lamSym) = homWord lam t w 0 := by
  induction w with
  | nil => simp
  | cons i w ih => simp [ih, genRatio_lamSym, genTrans_lamSym hθ]

/-- At `r_1 = ⋯ = r_5 = 0` a word with a symbol outside `1, 2, 3` has derivative `0`. -/
theorem genDeriv_special (hθ : Special θ) (w : List (Fin 3)) {j : Fin 4 × ZMod 2}
    (hj : ∀ i, j ≠ lamSym i) (l : List (Fin 4 × ZMod 2)) :
    genDeriv lam θ (w.map lamSym ++ j :: l) = 0 := by
  rw [genDeriv_append, genDeriv_cons, genRatio_of_ne hθ hj, zero_mul, mul_zero]

/-- The terms of `g_{𝐤 j 𝐥}(0)` with no factor from `r_1, …, r_5`, at `q = 0`: the translation
parameter of the first symbol `j` outside `1, 2, 3` has the coefficient `λ^{|𝐤|}`, and the
remaining term is `h_𝐤(0)` (tex lines 1425 to 1432). -/
theorem genVal_special (hθ : Special θ) (w : List (Fin 3)) {j : Fin 4 × ZMod 2}
    (hj : ∀ i, j ≠ lamSym i) (l : List (Fin 4 × ZMod 2)) :
    genVal lam t θ (w.map lamSym ++ j :: l) =
      lam ^ w.length * θ (slot j) + homWord lam t w 0 := by
  rw [genVal_append, genVal_cons, genRatio_of_ne hθ hj, zero_mul, zero_add, genTrans_of_ne hj,
    genDeriv_map_lamSym, genVal_map_lamSym hθ]

end Special

/-! ### Freeness -/

section Free

variable {K : Subfield ℝ} {lam t : ℝ} {x : Fin 11 → ℝ}

/-- At a tuple with non-zero entries and `λ ≠ 0` every ratio is non-zero. -/
theorem genRatio_ne_zero (hlam : lam ≠ 0) (hx : ∀ k, x k ≠ 0) (p : Fin 4 × ZMod 2) :
    genRatio lam x p ≠ 0 := by
  obtain ⟨i, c⟩ := p
  fin_cases i <;> rcases zmod_two_cases c with rfl | rfl <;> simp [genRatio, hlam, hx]

/-- At a tuple with non-zero entries and `λ ≠ 0` every map `g_𝐣` is invertible. -/
theorem genDeriv_ne_zero (hlam : lam ≠ 0) (hx : ∀ k, x k ≠ 0) (u : List (Fin 4 × ZMod 2)) :
    genDeriv lam x u ≠ 0 := by
  induction u with
  | nil => simp
  | cons p u ih => simpa using ⟨genRatio_ne_zero hlam hx p, ih⟩

/-- The freeness argument of `prop:ssc_no_overlap_not_pesc` (tex lines 1407 to 1436). Let
`0 < λ < 1`, let the homogeneous system `(λx, λx + t, λx + 1)` generate a free semigroup, and
let the parameters `x` be algebraically independent over a subfield `K ∋ λ, t` of `ℝ`. Then two
words `𝐢, 𝐣` over the eight symbols with `g_𝐢' = g_𝐣'` and `g_𝐢(0) = g_𝐣(0)` are equal.

Both identities hold at every real tuple. At `r_1 = ⋯ = r_5 = q = 0` a word of `λ`-symbols has
derivative `λ^n ≠ 0` and every other word has derivative `0`, so either both words consist of
`λ`-symbols, and they agree by the freeness of the homogeneous system, or both decompose as
`𝐤 j 𝐥` and `𝐤' j' 𝐥'`. The coefficients of the translation parameter of `j` give `j = j'` and
`|𝐤| = |𝐤'|`, the remaining terms give `h_𝐤(0) = h_{𝐤'}(0)`, hence `𝐤 = 𝐤'`. Cancelling the
invertible map `g_{𝐤 j}` at the tuple `x` reduces the claim to the shorter words `𝐥, 𝐥'`. -/
theorem eq_of_genDeriv_eq_of_genVal_eq (hlam0 : 0 < lam) (hlam1 : lam < 1)
    (hfree : HomFree lam t) (hlamK : lam ∈ K) (htK : t ∈ K) (hx : AlgebraicIndependent K x)
    {u u' : List (Fin 4 × ZMod 2)} (hD : genDeriv lam x u = genDeriv lam x u')
    (hV : genVal lam t x u = genVal lam t x u') : u = u' := by
  induction hn : u.length using Nat.strong_induction_on generalizing u u' with
  | _ n ih =>
    have hpow : Function.Injective fun m : ℕ => lam ^ m := pow_right_injective₀ hlam0 hlam1.ne
    have hD' := genDeriv_transfer hlamK hx hD
    have hV' := genVal_transfer hlamK htK hx hV
    obtain ⟨w, rest, rfl, hrest⟩ := exists_lamSym_prefix u
    obtain ⟨w', rest', rfl, hrest'⟩ := exists_lamSym_prefix u'
    rcases hrest with rfl | ⟨j, l, hj, rfl⟩ <;> rcases hrest' with rfl | ⟨j', l', hj', rfl⟩
    · -- Both words consist of `λ`-symbols.
      have h1 := hD' 0
      have h2 := hV' 0
      simp only [List.append_nil, genDeriv_map_lamSym, genVal_map_lamSym special_zero] at h1 h2
      rw [hfree.eq_of_length_eq (hpow h1) h2]
    · have h1 := hD' 0
      rw [List.append_nil, genDeriv_map_lamSym, genDeriv_special special_zero w' hj'] at h1
      exact absurd h1 (pow_pos hlam0 _).ne'
    · have h1 := hD' 0
      rw [List.append_nil, genDeriv_map_lamSym, genDeriv_special special_zero w hj] at h1
      exact absurd h1.symm (pow_pos hlam0 _).ne'
    · -- Both words contain a symbol that is not a `λ`-symbol.
      have h0 := hV' 0
      rw [genVal_special special_zero w hj, genVal_special special_zero w' hj'] at h0
      simp only [Pi.zero_apply, mul_zero, zero_add] at h0
      have h1 := hV' (Pi.single (slot j) 1)
      rw [genVal_special (special_single j) w hj, genVal_special (special_single j) w' hj', h0,
        Pi.single_eq_same, mul_one] at h1
      have h2 : lam ^ w.length =
          lam ^ w'.length * (Pi.single (slot j) (1 : ℝ) : Fin 11 → ℝ) (slot j') := by
        linarith
      have hjj : j = j' := by
        by_contra hne
        have hs : slot j' ≠ slot j := fun h => hne (slot_injOn j j' hj hj' h.symm)
        rw [Pi.single_eq_of_ne hs, mul_zero] at h2
        exact (pow_pos hlam0 _).ne' h2
      subst hjj
      rw [Pi.single_eq_same, mul_one] at h2
      have hw : w = w' := hfree.eq_of_length_eq (hpow h2) h0
      subst hw
      -- Cancel the common prefix `𝐤 j`.
      have hne : genDeriv lam x (w.map lamSym ++ [j]) ≠ 0 :=
        genDeriv_ne_zero hlam0.ne' (fun k => hx.ne_zero k) _
      have e : ∀ l : List (Fin 4 × ZMod 2),
          w.map lamSym ++ j :: l = (w.map lamSym ++ [j]) ++ l := fun l => by simp
      rw [e l, e l', genDeriv_append _ _ _ l, genDeriv_append _ _ _ l'] at hD
      rw [e l, e l', genVal_append _ _ _ _ l, genVal_append _ _ _ _ l'] at hV
      have hDl : genDeriv lam x l = genDeriv lam x l' := mul_left_cancel₀ hne hD
      have hVl : genVal lam t x l = genVal lam t x l' :=
        mul_left_cancel₀ hne (add_right_cancel hV)
      have hlen : l.length < n := by
        rw [← hn]; simp; omega
      rw [ih l.length hlen hDl hVl rfl]

end Free

/-! ### Algebraically independent parameters -/

section Parameters

open Cardinal

/-- A non-empty open interval of `ℝ` contains a number transcendental over a countable domain:
the numbers algebraic over a countable domain form a countable set. -/
theorem exists_transcendental_mem_Ioo (R : Type*) [CommRing R] [IsDomain R] [Algebra R ℝ]
    [Module.IsTorsionFree R ℝ] [Countable R] {a b : ℝ} (hab : a < b) :
    ∃ y ∈ Set.Ioo a b, Transcendental R y := by
  by_contra hcon
  have hsub : Set.Ioo a b ⊆ {y : ℝ | IsAlgebraic R y} := by
    intro y hy
    by_contra hy'
    exact hcon ⟨y, hy, hy'⟩
  exact absurd (Real.Ioo_countable_iff.1 ((Algebraic.countable R ℝ).mono hsub)) (not_le.2 hab)

/-- The subfield of `ℝ` generated by a countable set is countable. In particular `ℚ(λ, t)` is
countable. -/
theorem countable_closure {s : Set ℝ} (hs : s.Countable) : Countable (Subfield.closure s) := by
  rw [← mk_le_aleph0_iff]
  exact (Subfield.cardinalMk_closure_le_max s).trans
    (max_le (le_aleph0_iff_set_countable.2 hs) le_rfl)

/-- The choice of parameters in `prop:ssc_no_overlap_not_pesc` (tex lines 1354 to 1368): every
box of non-empty open intervals contains a tuple that is algebraically independent over a
countable subfield `K` of `ℝ`. The coordinates are chosen one at a time, each transcendental
over the countable algebra generated over `K` by the previous ones. -/
theorem exists_algebraicIndependent_mem_Ioo (K : Subfield ℝ) [Countable K] :
    ∀ (n : ℕ) (lo hi : Fin n → ℝ), (∀ k, lo k < hi k) →
      ∃ x : Fin n → ℝ, AlgebraicIndependent K x ∧ ∀ k, x k ∈ Set.Ioo (lo k) (hi k) := by
  intro n
  induction n with
  | zero =>
    intro lo hi _
    exact ⟨Fin.elim0, algebraicIndependent_empty_type_iff.2 (algebraMap K ℝ).injective,
      fun k => k.elim0⟩
  | succ n ih =>
    intro lo hi h
    obtain ⟨x, hx, hmem⟩ := ih (Fin.tail lo) (Fin.tail hi) fun k => h k.succ
    have : Countable (Algebra.adjoin K (Set.range x)) := by
      rw [← mk_le_aleph0_iff]
      refine (Algebra.cardinalMk_adjoin_le K (Set.range x)).trans ?_
      exact max_le (max_le mk_le_aleph0 (le_aleph0_iff_set_countable.2 (Set.countable_range x)))
        le_rfl
    obtain ⟨y, hy, hytr⟩ := exists_transcendental_mem_Ioo (Algebra.adjoin K (Set.range x)) (h 0)
    refine ⟨Fin.cons y x, ?_, ?_⟩
    · have hopt := (hx.option_iff_transcendental y).2 hytr
      rw [← algebraicIndependent_equiv (_root_.finSuccEquiv n)] at hopt
      convert hopt using 1
      funext k
      refine Fin.cases ?_ (fun k => ?_) k <;> simp
    · intro k
      refine Fin.cases ?_ (fun k => ?_) k
      · simpa using hy
      · simpa [Fin.tail] using hmem k

end Parameters

end NoOverlap

end BoxLike
