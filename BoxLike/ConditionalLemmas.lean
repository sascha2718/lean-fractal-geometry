module

/-
The three lemmas on conditional measures of `sec:conditional` (tex lines 1694 to 1772):
restriction to a Borel set, successive conditioning on nested measurable partitions, and
inheritance of Dirac conditional measures by a finer partition. The proofs follow the article:
each identity is checked against the sets of the conditioning `σ`-algebra and then follows from
the uniqueness of the disintegration, `condMeas_unique`.

* `saturated_mono`: `\widehat{ξ} ⊆ \widehat{ξ'}` when `ξ'` refines `ξ`.
* `measurableSet_saturated_of_forall_subset`: a Borel union of atoms of a measurable partition
  lies in `\widehat{ξ}`.
* `exists_countable_piSystem_saturated`: for a measurable partition, `\widehat{ξ}` is generated
  by a countable `π`-system.
* `condMeas_cond`, `condMeas_cond_of_saturated`:
  `thm:conditional_measures_of_a_conditional_measure`.
* `condMeas_dirac`: the conditional measure of `δ_x` at `x` is `δ_x`.
* `double_conditional`: `thm:double_conditional`.
* `finer_partition_dirac_mass`: `thm:finer_partition_dirac_mass`.
-/
public import BoxLike.ConditionalMeasures
public import Mathlib.MeasureTheory.Measure.Dirac.Def
public import Mathlib.MeasureTheory.Measure.Dirac.Basic
public import Mathlib.MeasureTheory.Measure.GiryMonad
public import Mathlib.MeasureTheory.Measure.WithDensity
public import Mathlib.Probability.ConditionalProbability
public import Mathlib.Probability.Kernel.MeasurableLIntegral

@[expose] public section

namespace BoxLike

open MeasureTheory ProbabilityTheory Set
open scoped ENNReal

/-! ### The `σ`-algebra of a measurable partition -/

section Saturated

variable {Ω : Type*} [MeasurableSpace Ω]

/-- If `ξ'(x) ⊆ ξ(x)` for every `x`, then `\widehat{ξ} ⊆ \widehat{ξ'}`: the first sentence of
the proof of `thm:double_conditional`. -/
theorem saturated_mono {ξ ξ' : Ω → Set Ω} (hfine : ∀ x, ξ' x ⊆ ξ x) :
    saturated ξ ≤ saturated ξ' :=
  fun _ hA => ⟨hA.1, fun x y hxy => hA.2 x y (hfine x hxy)⟩

/-- A Borel set that is a union of atoms of a measurable partition `ξ` lies in `\widehat{ξ}`
(`thm:conditional_measures_of_a_conditional_measure`, second part). The symmetry of the relation
`y ∈ ξ(x)` comes from the Borel map inducing `ξ`. -/
theorem measurableSet_saturated_of_forall_subset {ξ : Ω → Set Ω} (hξ : IsMeasurablePartition ξ)
    {Ξ : Set Ω} (hΞ : MeasurableSet Ξ) (hsat : ∀ x ∈ Ξ, ξ x ⊆ Ξ) :
    MeasurableSet[saturated ξ] Ξ := by
  obtain ⟨f, -, hf⟩ := hξ
  refine ⟨hΞ, fun x y hxy => ⟨fun hx => hsat x hx hxy, fun hy => hsat y hy ?_⟩⟩
  exact (hf y x).2 ((hf x y).1 hxy).symm

end Saturated

/-! ### The lemmas of `sec:conditional` -/

section Conditional

variable {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]

/-- For a measurable partition the `σ`-algebra `\widehat{ξ}` is generated by a countable
`π`-system containing the whole space (`sec:conditional`, tex lines 1675 to 1680: "these
`σ`-algebras are countably generated before completion"). By `saturated_eq_comap` it is the
pull-back of the Borel `σ`-algebra of `ℝ`, which a countable basis generates. -/
theorem exists_countable_piSystem_saturated {ξ : Ω → Set Ω} (hξ : IsMeasurablePartition ξ) :
    ∃ C : Set (Set Ω), C.Countable ∧ IsPiSystem C ∧ univ ∈ C ∧
      saturated ξ = MeasurableSpace.generateFrom C := by
  obtain ⟨f, hf, hfξ⟩ := hξ
  have hb := TopologicalSpace.isBasis_countableBasis ℝ
  obtain ⟨C, hCc, hCpi, hCuniv, hCgen⟩ := exists_countable_piSystem_generateFrom
    ((TopologicalSpace.countable_countableBasis ℝ).image (preimage f))
  refine ⟨C, hCc, hCpi, hCuniv, ?_⟩
  rw [hCgen, saturated_eq_comap hf hfξ, ← MeasurableSpace.comap_generateFrom,
    ← hb.borel_eq_generateFrom, BorelSpace.measurable_eq (α := ℝ)]

/-- `thm:conditional_measures_of_a_conditional_measure`, first part (Feng, Lemma 2.9):
for Borel `Ξ` with `μ(Ξ) > 0`, `μ_x^ξ(Ξ) > 0` and `(μ_Ξ)_x^ξ = (μ_x^ξ)_Ξ` for `μ_Ξ`-almost every
`x`. The equality of measures is the article's "simultaneously for all Borel sets `A`". The
article states the lemma on `Σ_Z` and on `Σ`; it holds on every standard Borel space.
Depends on: `setLIntegral_condMeas`, `setLIntegral_mul_condMeas`, `condMeas_unique`.
The proof uses neither of the hypotheses `_hξ` and `_hpos`: the identity holds for every map
`ξ`, and `μ_Ξ` is the zero measure when `μ(Ξ) = 0`. -/
theorem condMeas_cond (μ : Measure Ω) [IsProbabilityMeasure μ] {ξ : Ω → Set Ω}
    (_hξ : IsMeasurablePartition ξ) {Ξ : Set Ω} (hΞ : MeasurableSet Ξ) (_hpos : 0 < μ Ξ) :
    ∀ᵐ x ∂μ[|Ξ], 0 < condMeas μ ξ x Ξ ∧ condMeas μ[|Ξ] ξ x = (condMeas μ ξ x)[|Ξ] := by
  have hm := saturated_le (Ω := Ω) ξ
  have hpm : Measurable[saturated ξ] fun x => condMeas μ ξ x Ξ := measurable_condMeas μ ξ hΞ
  have hzero : MeasurableSet[saturated ξ] {x | condMeas μ ξ x Ξ = 0} :=
    hpm (measurableSet_singleton 0)
  have h0 : μ[|Ξ] {x | condMeas μ ξ x Ξ = 0} = 0 := by
    rw [cond_apply hΞ, ← setLIntegral_condMeas μ ξ hΞ hzero,
      setLIntegral_congr_fun (hm _ hzero) (fun x hx => hx)]
    simp
  have hposae : ∀ᵐ x ∂μ[|Ξ], 0 < condMeas μ ξ x Ξ := by
    rw [ae_iff]
    simpa [pos_iff_ne_zero] using h0
  have hK : ∀ A, MeasurableSet A →
      Measurable[saturated ξ] fun x => (condMeas μ ξ x)[|Ξ] A := by
    intro A hA
    simp_rw [cond_apply hΞ]
    exact hpm.inv.mul (measurable_condMeas μ ξ (hΞ.inter hA))
  have hint : ∀ A B, MeasurableSet A → MeasurableSet[saturated ξ] B →
      ∫⁻ x in B, (condMeas μ ξ x)[|Ξ] A ∂μ[|Ξ] = μ[|Ξ] (A ∩ B) := by
    intro A B hA hB
    rw [cond_apply hΞ, ProbabilityTheory.cond, Measure.restrict_smul, lintegral_smul_measure,
      Measure.restrict_restrict (hm _ hB), smul_eq_mul]
    congr 1
    rw [inter_comm B Ξ, ← setLIntegral_mul_condMeas μ ξ (hK A hA) hΞ hB, ← inter_assoc,
      ← setLIntegral_condMeas μ ξ (hΞ.inter hA) hB]
    refine lintegral_congr fun x => ?_
    rw [cond_apply hΞ]
    rcases eq_or_ne (condMeas μ ξ x Ξ) 0 with h | h
    · rw [h, measure_mono_null inter_subset_left h]
      simp
    · rw [mul_right_comm, ENNReal.inv_mul_cancel h (measure_ne_top _ _), one_mul]
  filter_upwards [hposae, condMeas_unique μ[|Ξ] ξ _ hK hint] with x hx1 hx2
  exact ⟨hx1, hx2.symm⟩

/-- `thm:conditional_measures_of_a_conditional_measure`, second part: if `Ξ` is a union of
atoms of `ξ`, then `(μ_Ξ)_x^ξ = μ_x^ξ` for `μ`-almost every `x ∈ Ξ`.
Depends on: `condMeas_cond`, `condMeas_of_saturated`. -/
theorem condMeas_cond_of_saturated (μ : Measure Ω) [IsProbabilityMeasure μ] {ξ : Ω → Set Ω}
    (hξ : IsMeasurablePartition ξ) {Ξ : Set Ω} (hΞ : MeasurableSet Ξ) (hpos : 0 < μ Ξ)
    (hsat : ∀ x ∈ Ξ, ξ x ⊆ Ξ) :
    ∀ᵐ x ∂μ, x ∈ Ξ → condMeas μ[|Ξ] ξ x = condMeas μ ξ x := by
  have hΞs := measurableSet_saturated_of_forall_subset hξ hΞ hsat
  have h1 : ∀ᵐ x ∂μ, x ∈ Ξ → condMeas μ[|Ξ] ξ x = (condMeas μ ξ x)[|Ξ] := by
    have hac : μ.restrict Ξ ≪ μ[|Ξ] := by
      rw [ProbabilityTheory.cond]
      exact Measure.absolutelyContinuous_smul (ENNReal.inv_ne_zero.2 (measure_ne_top μ Ξ))
    have h := (ae_restrict_iff' hΞ).1 (hac.ae_le (condMeas_cond μ hξ hΞ hpos))
    filter_upwards [h] with x hx hxΞ using (hx hxΞ).2
  filter_upwards [h1, condMeas_of_saturated μ ξ hΞs] with x hx1 hx2 hxΞ
  rw [hx1 hxΞ]
  rw [indicator_of_mem hxΞ, Pi.one_apply] at hx2
  have hae : ∀ᵐ y ∂condMeas μ ξ x, y ∈ Ξ := by
    rw [ae_iff]
    exact (prob_compl_eq_zero_iff hΞ).2 hx2
  rw [ProbabilityTheory.cond, hx2, inv_one, one_smul, Measure.restrict_eq_self_of_ae_mem hae]

/-- "The conditional measure of `δ_𝐣` at `𝐣` is `δ_𝐣` for any measurable partition" (proof of
`thm:finer_partition_dirac_mass`). It holds for every map `ξ`, by `condMeas_unique` applied to
the constant family `δ_x`. -/
theorem condMeas_dirac (ξ : Ω → Set Ω) (x : Ω) :
    condMeas (Measure.dirac x) ξ x = Measure.dirac x := by
  have hm := saturated_le (Ω := Ω) ξ
  have h := condMeas_unique (Measure.dirac x) ξ (fun _ => Measure.dirac x)
    (fun A _ => measurable_const) fun A B hA hB => by
      rw [setLIntegral_const, Measure.dirac_apply' _ hA, Measure.dirac_apply' _ (hm _ hB),
        Measure.dirac_apply' _ (hA.inter (hm _ hB))]
      by_cases hxA : x ∈ A <;> by_cases hxB : x ∈ B <;> simp [hxA, hxB]
  rw [ae_dirac_eq, Filter.eventually_pure] at h
  exact h.symm

/-- `thm:double_conditional`: if `ξ'` refines `ξ`, then `(μ_j^ξ)_i^{ξ'} = μ_i^{ξ'}` for
`μ`-almost every `j` and `μ_j^ξ`-almost every `i`, and
`∫∫ μ_i^{ξ'}(A) dμ_j^ξ(i) dμ(j) = ∫ μ_i^{ξ'}(A) dμ(i)` for every Borel set `A`. The article takes
partitions of a Borel set `Σ'` of full measure; here they are partitions of `Ω`, which for
`ξ_i`, `ξ_1^⊥`, `\overline{ξ}_i` is the extension by one atom of `atomsOn`.
Depends on: `setLIntegral_condMeas`, `setLIntegral_lintegral_condMeas`, `condMeas_unique`,
`exists_countable_piSystem_saturated`.
As in the article, the identity `∫_B μ_i^{ξ'}(A) dμ_j^ξ(i) = μ_j^ξ(A ∩ B)` is first obtained for
`A` and `B` in countable generating `π`-systems on one full-measure set of `j`, and then for all
Borel `A` and all `B ∈ \widehat{ξ'}`, because both sides are finite measures in `A` and in `B`.
The proof does not use the hypothesis `_hξ`: only `ξ'` has to be a measurable partition, which
makes `\widehat{ξ'}` countably generated. -/
theorem double_conditional (μ : Measure Ω) [IsProbabilityMeasure μ] {ξ ξ' : Ω → Set Ω}
    (_hξ : IsMeasurablePartition ξ) (hξ' : IsMeasurablePartition ξ')
    (hfine : ∀ x, ξ' x ⊆ ξ x) :
    (∀ᵐ j ∂μ, ∀ᵐ i ∂condMeas μ ξ j, condMeas (condMeas μ ξ j) ξ' i = condMeas μ ξ' i) ∧
    ∀ A, MeasurableSet A →
      ∫⁻ j, ∫⁻ i, condMeas μ ξ' i A ∂condMeas μ ξ j ∂μ = ∫⁻ i, condMeas μ ξ' i A ∂μ := by
  have hm := saturated_le (Ω := Ω) ξ
  have hm' := saturated_le (Ω := Ω) ξ'
  have hmono := saturated_mono hfine
  have hκ' : ∀ A, MeasurableSet A → Measurable fun i => condMeas μ ξ' i A := fun A hA =>
    (measurable_condMeas μ ξ' hA).mono hm' le_rfl
  have hκ'm : Measurable (condMeas μ ξ') := Measure.measurable_of_measurable_coe _ hκ'
  refine ⟨?_, fun A hA => ?_⟩
  swap
  · have h := setLIntegral_lintegral_condMeas μ ξ (hκ' A hA) (B := univ) MeasurableSet.univ
    simpa using h
  obtain ⟨𝒜, h𝒜c, h𝒜pi, h𝒜univ, h𝒜gen⟩ := exists_countable_piSystem_generateFrom
    (MeasurableSpace.countable_countableGeneratingSet (α := Ω))
  rw [MeasurableSpace.generateFrom_countableGeneratingSet] at h𝒜gen
  obtain ⟨ℬ, hℬc, hℬpi, hℬuniv, hℬgen⟩ := exists_countable_piSystem_saturated hξ'
  have h𝒜m : ∀ A ∈ 𝒜, MeasurableSet A := fun A hA => by
    rw [← h𝒜gen]
    exact MeasurableSpace.measurableSet_generateFrom hA
  have hℬm : ∀ B ∈ ℬ, MeasurableSet[saturated ξ'] B := fun B hB => by
    rw [hℬgen]
    exact MeasurableSpace.measurableSet_generateFrom hB
  -- The identity for fixed `A` and `B`, tested against the sets of `\widehat{ξ}`.
  have h1 : ∀ A ∈ 𝒜, ∀ B ∈ ℬ, ∀ᵐ j ∂μ,
      ∫⁻ i in B, condMeas μ ξ' i A ∂condMeas μ ξ j = condMeas μ ξ j (A ∩ B) := by
    intro A hA B hB
    have hAm := h𝒜m A hA
    have hBm := hℬm B hB
    refine ae_eq_of_forall_setLIntegral_eq_of_le hm ?_
      (measurable_condMeas μ ξ (hAm.inter (hm' _ hBm))) fun C hC => ?_
    · exact Measurable.setLIntegral_kernel (κ := condExpKernel μ (saturated ξ)) (hκ' A hAm)
        (hm' _ hBm)
    · have hBC : MeasurableSet[saturated ξ'] (B ∩ C) :=
        @MeasurableSet.inter _ (saturated ξ') _ _ hBm (hmono _ hC)
      simp_rw [← lintegral_indicator (hm' _ hBm)]
      rw [setLIntegral_lintegral_condMeas μ ξ ((hκ' A hAm).indicator (hm' _ hBm)) hC,
        setLIntegral_indicator (hm' _ hBm), setLIntegral_condMeas μ ξ' hAm hBC,
        setLIntegral_condMeas μ ξ (hAm.inter (hm' _ hBm)) hC, inter_assoc]
  have h2 : ∀ᵐ j ∂μ, ∀ A ∈ 𝒜, ∀ B ∈ ℬ,
      ∫⁻ i in B, condMeas μ ξ' i A ∂condMeas μ ξ j = condMeas μ ξ j (A ∩ B) :=
    (ae_ball_iff h𝒜c).2 fun A hA => (ae_ball_iff hℬc).2 (h1 A hA)
  filter_upwards [h2] with j hj
  -- Both sides are finite measures in `A`.
  have h3 : ∀ B ∈ ℬ, ∀ A, MeasurableSet A →
      ∫⁻ i in B, condMeas μ ξ' i A ∂condMeas μ ξ j = condMeas μ ξ j (A ∩ B) := by
    intro B hB A hA
    have hext : (condMeas μ ξ j).restrict B
        = ((condMeas μ ξ j).restrict B).bind (condMeas μ ξ') := by
      refine ext_of_generate_finite 𝒜 h𝒜gen.symm h𝒜pi (fun A hA => ?_) ?_
      · rw [Measure.bind_apply (h𝒜m A hA) hκ'm.aemeasurable,
          Measure.restrict_apply (h𝒜m A hA), hj A hA B hB]
      · rw [Measure.bind_apply MeasurableSet.univ hκ'm.aemeasurable,
          Measure.restrict_apply MeasurableSet.univ, hj univ h𝒜univ B hB]
    rw [← Measure.bind_apply hA hκ'm.aemeasurable, ← hext, Measure.restrict_apply hA]
  -- Both sides are finite measures in `B` on `\widehat{ξ'}`.
  have h4 : ∀ A B, MeasurableSet A → MeasurableSet[saturated ξ'] B →
      ∫⁻ i in B, condMeas μ ξ' i A ∂condMeas μ ξ j = condMeas μ ξ j (A ∩ B) := by
    intro A B hA hB
    have hext : ((condMeas μ ξ j).restrict A).trim hm'
        = ((condMeas μ ξ j).withDensity fun i => condMeas μ ξ' i A).trim hm' := by
      refine ext_of_generate_finite ℬ hℬgen hℬpi (fun B hB => ?_) ?_
      · rw [trim_measurableSet_eq hm' (hℬm B hB), trim_measurableSet_eq hm' (hℬm B hB),
          Measure.restrict_apply (hm' _ (hℬm B hB)), withDensity_apply _ (hm' _ (hℬm B hB)),
          h3 B hB A hA, inter_comm]
      · rw [trim_measurableSet_eq hm' MeasurableSet.univ,
          trim_measurableSet_eq hm' MeasurableSet.univ,
          Measure.restrict_apply MeasurableSet.univ, withDensity_apply _ MeasurableSet.univ,
          h3 univ hℬuniv A hA, inter_comm]
    have h5 := congrArg (fun ρ : @Measure Ω (saturated ξ') => ρ B) hext
    simp only [trim_measurableSet_eq hm' hB, Measure.restrict_apply (hm' _ hB),
      withDensity_apply _ (hm' _ hB)] at h5
    rw [← h5, inter_comm]
  filter_upwards [condMeas_unique (condMeas μ ξ j) ξ' (condMeas μ ξ')
    (fun A hA => measurable_condMeas μ ξ' hA) h4] with i hi
  exact hi.symm

/-- `thm:finer_partition_dirac_mass`: if `ξ'` refines `ξ` and `μ_x^ξ = δ_x` for `μ`-almost
every `x`, then `μ_x^{ξ'} = δ_x` for `μ`-almost every `x`. The article writes
`μ({x : μ_x^ξ = δ_x}) = 1`; the almost-everywhere form avoids the measurability of that set.
Depends on: `thm:double_conditional`, `condMeas_dirac`. -/
theorem finer_partition_dirac_mass (μ : Measure Ω) [IsProbabilityMeasure μ] {ξ ξ' : Ω → Set Ω}
    (hξ : IsMeasurablePartition ξ) (hξ' : IsMeasurablePartition ξ')
    (hfine : ∀ x, ξ' x ⊆ ξ x) (h : ∀ᵐ x ∂μ, condMeas μ ξ x = Measure.dirac x) :
    ∀ᵐ x ∂μ, condMeas μ ξ' x = Measure.dirac x := by
  have key : ∀ (j : Ω) (ν : Measure Ω) [IsFiniteMeasure ν], ν = Measure.dirac j →
      (∀ᵐ i ∂ν, condMeas ν ξ' i = condMeas μ ξ' i) → condMeas μ ξ' j = Measure.dirac j := by
    rintro j ν _ rfl hν
    rw [ae_dirac_eq, Filter.eventually_pure] at hν
    rw [← hν, condMeas_dirac]
  filter_upwards [h, (double_conditional μ hξ hξ' hfine).1] with j hj hj1
  exact key j _ hj hj1

end Conditional

end BoxLike
