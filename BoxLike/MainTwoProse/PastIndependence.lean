module

/-
The independence of the past and the future of a Bernoulli measure in the proof of `thm:main2`
in `sec:dimension_result_proof`: "Since `ν_n` is Bernoulli and the Oseledets subspace `V^1` is
the `y`-axis, `h_1(ν_n)` is the conditional entropy of the first symbol given the horizontal
coordinate of the coded point." The conditional entropies `q_{x,n}`, `q_{y,n}`, `q_n` of
`BoxLike/MainTwoProse/SubsystemEntropies.lean` condition the first symbol on the horizontal
coordinate, the vertical coordinate and the planar point of the coded point only;
the partitions `ξ_1`, `ξ_1^⊥`, `ξ_2` of `sec:entropies` condition also on the past. For a
Bernoulli measure the past `σ`-algebra is independent of the future `σ`-algebra, which contains
the cylinder `[a]` and the coded point, so the conditional expectations agree and the
conditional entropies coincide.

* `sup_eq_generateFrom_inter`, `isPiSystem_inter`: `m₁ ⊔ G` is generated by the `π`-system of
  the intersections `B ∩ C`.
* `condExp_indicator_sup_indep`: `E(1_A | m₁ ⊔ G) = E(1_A | G)` when `m₁` is independent of a
  `σ`-algebra containing `A` and `G`.
* `pastSigma`, `futureSigma`, `indep_pastSigma_futureSigma`: the past and the future of a
  Bernoulli measure are independent.
* `measurable_futureSigma_of_future`: a Borel map that depends only on the future is measurable
  with respect to the future `σ`-algebra.
* `saturated_samePast_eq`, `saturated_fibre_eq`: the `σ`-algebras of the partitions by the past
  and a Borel map, and by the map alone.
* `isMeasurablePartition_fibre`: the fibres of a Borel map into a standard Borel space form a
  measurable partition.
* `condEntropy_samePast_eq_of_future`: for a Bernoulli measure and a Borel map of the future,
  conditioning on the past in addition does not change the conditional entropy.
* `condEntropy_eq_zero_of_subset_cylinder`: if every atom lies in the cylinder of its first
  symbol, the conditional entropy vanishes.
-/
public import BoxLike.ConditionalTwoWays
public import BoxLike.InvariantMeasure
public import BoxLike.MainTwoProse.EntropyThreshold
public import BoxLike.MeasurablePartitions
public import Mathlib.Probability.Independence.InfinitePi
public import Mathlib.Probability.Independence.Integration

@[expose] public section

namespace BoxLike

open MeasureTheory ProbabilityTheory Set

/-! ### Conditional expectations given an independent `σ`-algebra -/

section Indep

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-- `m₁ ⊔ G` is generated by the intersections `B ∩ C` with `B ∈ m₁` and `C ∈ G`. -/
theorem sup_eq_generateFrom_inter (m₁ G : MeasurableSpace Ω) :
    m₁ ⊔ G = MeasurableSpace.generateFrom
      {t | ∃ B C, MeasurableSet[m₁] B ∧ MeasurableSet[G] C ∧ t = B ∩ C} := by
  apply le_antisymm
  · refine sup_le (fun B hB => ?_) (fun C hC => ?_)
    · exact MeasurableSpace.measurableSet_generateFrom
        ⟨B, univ, hB, MeasurableSet.univ, (inter_univ B).symm⟩
    · exact MeasurableSpace.measurableSet_generateFrom
        ⟨univ, C, MeasurableSet.univ, hC, (univ_inter C).symm⟩
  · refine MeasurableSpace.generateFrom_le ?_
    rintro _ ⟨B, C, hB, hC, rfl⟩
    exact (le_sup_left (a := m₁) (b := G) _ hB).inter (le_sup_right (a := m₁) (b := G) _ hC)

/-- The intersections `B ∩ C` with `B ∈ m₁` and `C ∈ G` form a `π`-system. -/
theorem isPiSystem_inter (m₁ G : MeasurableSpace Ω) :
    IsPiSystem {t | ∃ B C, MeasurableSet[m₁] B ∧ MeasurableSet[G] C ∧ t = B ∩ C} := by
  rintro _ ⟨B, C, hB, hC, rfl⟩ _ ⟨B', C', hB', hC', rfl⟩ _
  refine ⟨B ∩ B', C ∩ C', hB.inter hB', hC.inter hC', ?_⟩
  ext x
  simp only [mem_inter_iff]
  tauto

variable {μ : Measure Ω} [IsProbabilityMeasure μ] {m₁ m₂ G : MeasurableSpace Ω}

/-- Conditioning in addition on an independent `σ`-algebra changes nothing: if `m₁` and `m₂` are
independent, `G ⊆ m₂` and `A ∈ m₂`, then `E(1_A | m₁ ⊔ G) = E(1_A | G)` almost everywhere. On
the `π`-system of the sets `B ∩ C`, `∫_{B ∩ C} E(1_A | G) = μ(B) μ(A ∩ C) = μ(A ∩ B ∩ C)` by
independence. -/
theorem condExp_indicator_sup_indep (h₁ : m₁ ≤ mΩ) (h₂ : m₂ ≤ mΩ) (hG : G ≤ m₂)
    (hind : Indep m₁ m₂ μ) {A : Set Ω} (hA : MeasurableSet[m₂] A) :
    μ⟦A | G⟧ =ᵐ[μ] μ⟦A | m₁ ⊔ G⟧ := by
  have hGΩ : G ≤ mΩ := hG.trans h₂
  have hm : m₁ ⊔ G ≤ mΩ := sup_le h₁ hGΩ
  have hAm : MeasurableSet[mΩ] A := h₂ _ hA
  set f : Ω → ℝ := A.indicator fun _ => (1 : ℝ) with hf
  have hfi : Integrable f μ := (integrable_const 1).indicator hAm
  have hgi : Integrable (μ[f | G]) μ := integrable_condExp
  refine ae_eq_condExp_of_forall_setIntegral_eq hm hfi (fun s _ _ => hgi.integrableOn) ?_
    ((stronglyMeasurable_condExp (m := G) (μ := μ) (f := f)).mono
      (le_sup_right : G ≤ m₁ ⊔ G)).aestronglyMeasurable
  intro s hs _
  refine MeasurableSpace.induction_on_inter (m := m₁ ⊔ G)
    (C := fun s _ => ∫ x in s, μ[f | G] x ∂μ = ∫ x in s, f x ∂μ)
    (sup_eq_generateFrom_inter m₁ G) (isPiSystem_inter m₁ G) ?_ ?_ ?_ ?_ s hs
  · simp
  · rintro _ ⟨B, C, hB, hC, rfl⟩
    have hBΩ : MeasurableSet[mΩ] B := h₁ _ hB
    have hCΩ : MeasurableSet[mΩ] C := hGΩ _ hC
    -- the two factors are measurable with respect to independent `σ`-algebras
    have hX : Measurable[m₁] (B.indicator fun _ => (1 : ℝ)) :=
      (measurable_const (a := (1 : ℝ))).indicator hB
    have hY : Measurable[m₂] (C.indicator (μ[f | G])) :=
      (stronglyMeasurable_condExp.measurable.mono hG le_rfl).indicator (hG _ hC)
    have hXY : IndepFun (B.indicator fun _ => (1 : ℝ)) (C.indicator (μ[f | G])) μ := by
      rw [IndepFun_iff_Indep]
      exact indep_of_indep_of_le_left (indep_of_indep_of_le_right hind hY.comap_le) hX.comap_le
    have hprod : (B ∩ C).indicator (μ[f | G]) =
        fun x => B.indicator (fun _ => (1 : ℝ)) x * C.indicator (μ[f | G]) x := by
      funext x
      by_cases hxB : x ∈ B <;> by_cases hxC : x ∈ C <;> simp [hxB, hxC]
    have hone : ∀ {D : Set Ω}, MeasurableSet[mΩ] D → ∀ ν : @Measure Ω mΩ,
        ∫ x, D.indicator (fun _ => (1 : ℝ)) x ∂ν = ν.real D :=
      fun hD ν => integral_indicator_one hD
    have hlhs : ∫ x in B ∩ C, μ[f | G] x ∂μ = μ.real B * μ.real (A ∩ C) := by
      rw [← integral_indicator (hBΩ.inter hCΩ), hprod,
        hXY.integral_fun_mul_eq_mul_integral (hX.mono h₁ le_rfl).aestronglyMeasurable
          (hY.mono h₂ le_rfl).aestronglyMeasurable,
        hone hBΩ, integral_indicator hCΩ, setIntegral_condExp hGΩ hfi hC,
        hf, hone hAm, measureReal_restrict_apply hAm]
    have hrhs : ∫ x in B ∩ C, f x ∂μ = μ.real (A ∩ (B ∩ C)) := by
      rw [hf, hone hAm, measureReal_restrict_apply hAm]
    rw [hlhs, hrhs]
    have hset := (Indep_iff _ _ μ).1 hind B (A ∩ C) hB (hA.inter (hG _ hC))
    rw [measureReal_def, measureReal_def, measureReal_def, ← ENNReal.toReal_mul, ← hset,
      inter_left_comm]
  · intro t htm ht
    have htΩ := hm _ htm
    have h1 := integral_add_compl htΩ hgi
    have h2 := integral_add_compl htΩ hfi
    rw [integral_condExp hGΩ] at h1
    linarith
  · intro F hdisj hFm hF
    rw [integral_iUnion (fun i => hm _ (hFm i)) hdisj hgi.integrableOn,
      integral_iUnion (fun i => hm _ (hFm i)) hdisj hfi.integrableOn]
    exact tsum_congr hF

end Indep

/-! ### The past and the future of a Bernoulli measure -/

section Bernoulli

variable {α : Type*} [MeasurableSpace α]

/-- The `σ`-algebra of the past `𝐢^-`, generated by the coordinates `i_k`, `k < 0`. -/
abbrev pastSigma : MeasurableSpace (ℤ → α) :=
  ⨆ i ∈ {i : ℤ | i < 0}, MeasurableSpace.comap (fun x : ℤ → α => x i) inferInstance

/-- The `σ`-algebra of the future `𝐢^+`, generated by the coordinates `i_k`, `k ≥ 0`. -/
abbrev futureSigma : MeasurableSpace (ℤ → α) :=
  ⨆ i ∈ {i : ℤ | 0 ≤ i}, MeasurableSpace.comap (fun x : ℤ → α => x i) inferInstance

/-- The past `σ`-algebra is a sub-`σ`-algebra of the Borel `σ`-algebra. -/
theorem pastSigma_le : (pastSigma : MeasurableSpace (ℤ → α)) ≤ MeasurableSpace.pi :=
  iSup₂_le fun i _ => (measurable_pi_apply i).comap_le

/-- The future `σ`-algebra is a sub-`σ`-algebra of the Borel `σ`-algebra. -/
theorem futureSigma_le : (futureSigma : MeasurableSpace (ℤ → α)) ≤ MeasurableSpace.pi :=
  iSup₂_le fun i _ => (measurable_pi_apply i).comap_le

/-- The past and the future of a Bernoulli measure are independent (proof of `thm:main2`). -/
theorem indep_pastSigma_futureSigma (p : Measure α) [IsProbabilityMeasure p] :
    Indep pastSigma futureSigma (bernoulli p) := by
  have hind : iIndepFun (fun (i : ℤ) (x : ℤ → α) => x i) (bernoulli p) :=
    iIndepFun_infinitePi (P := fun _ : ℤ => p) (X := fun _ => id) fun _ => measurable_id
  refine indep_iSup_of_disjoint (fun i => (measurable_pi_apply i).comap_le) hind.iIndep ?_
  rw [Set.disjoint_left]
  intro i hi hi'
  simp only [Set.mem_ofPred_eq] at hi hi'
  omega

/-- A coordinate of the past is measurable with respect to the past `σ`-algebra. -/
theorem measurable_pastSigma_apply {i : ℤ} (hi : i < 0) :
    Measurable[pastSigma] fun x : ℤ → α => x i :=
  Measurable.of_comap_le (le_iSup₂ (f := fun (i : ℤ) (_ : i ∈ {i : ℤ | i < 0}) =>
    MeasurableSpace.comap (fun x : ℤ → α => x i) inferInstance) i hi)

/-- A coordinate of the future is measurable with respect to the future `σ`-algebra. -/
theorem measurable_futureSigma_apply {i : ℤ} (hi : 0 ≤ i) :
    Measurable[futureSigma] fun x : ℤ → α => x i :=
  Measurable.of_comap_le (le_iSup₂ (f := fun (i : ℤ) (_ : i ∈ {i : ℤ | 0 ≤ i}) =>
    MeasurableSpace.comap (fun x : ℤ → α => x i) inferInstance) i hi)

/-- The past `𝐢 ↦ 𝐢^-` is measurable with respect to the past `σ`-algebra. -/
theorem measurable_past_pastSigma : Measurable[pastSigma] (past : (ℤ → α) → ℕ → α) := by
  let _ : MeasurableSpace (ℤ → α) := pastSigma
  exact measurable_pi_iff.2 fun n => measurable_pastSigma_apply (Int.negSucc_lt_zero n)

/-- A Borel map that depends only on the future `𝐢^+` is measurable with respect to the future
`σ`-algebra: it factors through `𝐢 ↦ 𝐢^+`. -/
theorem measurable_futureSigma_of_future {Y : Type*} [MeasurableSpace Y]
    {F : (ℤ → α) → Y} (hF : Measurable F) (hfut : ∀ x y : ℤ → α, (∀ k : ℕ, x k = y k) → F x = F y) :
    Measurable[futureSigma] F := by
  have hfs : Measurable[futureSigma] (futureSeq : (ℤ → α) → ℕ → α) := by
    let _ : MeasurableSpace (ℤ → α) := futureSigma
    exact measurable_pi_iff.2 fun n => measurable_futureSigma_apply (Int.natCast_nonneg n)
  have h : F = (F ∘ extendFuture) ∘ futureSeq := by
    funext x
    exact hfut x _ fun k => (extendFuture_futureSeq x k).symm
  rw [h]
  exact (hF.comp measurable_extendFuture).comp hfs

variable [Fintype α] [MeasurableSingletonClass α]

/-- The `σ`-algebra of the partition by the past and a Borel map `F` into a standard Borel space
is the join of the past `σ`-algebra and the `σ`-algebra of `F`. -/
theorem saturated_samePast_eq {Y : Type*} [MeasurableSpace Y] [StandardBorelSpace Y]
    {F : (ℤ → α) → Y} (hF : Measurable F) :
    saturated (fun x : ℤ → α => {y | SamePast y x ∧ F y = F x}) =
      pastSigma ⊔ MeasurableSpace.comap F inferInstance := by
  apply le_antisymm
  · rw [saturated_eq_comap (f := fun x => (past x, F x)) (measurable_past.prodMk hF)
      (fun x y => by simp only [Set.mem_ofPred_eq, Prod.mk.injEq, past_eq_iff])]
    exact (Measurable.prodMk (measurable_past_pastSigma.mono le_sup_left le_rfl)
      ((comap_measurable F).mono le_sup_right le_rfl)).comap_le
  · refine sup_le (iSup₂_le fun i hi => ?_) ?_
    · exact (measurable_saturated_of_forall_eq (measurable_pi_apply i)
        fun x y hy => (hy.1 i hi).symm).comap_le
    · exact (measurable_saturated_of_forall_eq hF fun x y hy => hy.2.symm).comap_le

/-- The `σ`-algebra of the partition into the fibres of a Borel map `F` into a standard Borel
space is the `σ`-algebra of `F`. -/
theorem saturated_fibre_eq {Y : Type*} [MeasurableSpace Y] [StandardBorelSpace Y]
    {F : (ℤ → α) → Y} (hF : Measurable F) :
    saturated (fun x : ℤ → α => {y | F y = F x}) = MeasurableSpace.comap F inferInstance :=
  saturated_eq_comap hF fun _ _ => Iff.rfl

omit [Fintype α] [MeasurableSingletonClass α] in
/-- The fibres of a Borel map into a standard Borel space form a measurable partition. -/
theorem isMeasurablePartition_fibre {Y : Type*} [MeasurableSpace Y] [StandardBorelSpace Y]
    {F : (ℤ → α) → Y} (hF : Measurable F) :
    IsMeasurablePartition fun x : ℤ → α => {y | F y = F x} := by
  have he := measurableEmbedding_embeddingReal Y
  exact ⟨fun x => embeddingReal Y (F x), he.measurable.comp hF,
    fun x y => he.injective.eq_iff.symm⟩

/-- For a Bernoulli measure and a Borel map `F` of the future into a standard Borel space,
conditioning the first symbol on the past in addition to `F` does not change the conditional
entropy (proof of `thm:main2`: "since `ν_n` is Bernoulli and the Oseledets subspace `V^1` is the
`y`-axis"). -/
theorem condEntropy_samePast_eq_of_future (p : Measure α) [IsProbabilityMeasure p]
    {Y : Type*} [MeasurableSpace Y] [StandardBorelSpace Y] {F : (ℤ → α) → Y}
    (hF : Measurable F) (hfut : ∀ x y : ℤ → α, (∀ k : ℕ, x k = y k) → F x = F y) :
    condEntropy (bernoulli p) (fun x => {y | SamePast y x ∧ F y = F x}) =
      condEntropy (bernoulli p) (fun x => {y | F y = F x}) := by
  rw [condEntropy_eq_integral_sum_negMulLog, condEntropy_eq_integral_sum_negMulLog,
    saturated_samePast_eq hF, saturated_fibre_eq hF]
  have hA : ∀ a : α, MeasurableSet[futureSigma] {y : ℤ → α | y 0 = a} := fun a =>
    measurable_futureSigma_apply le_rfl (measurableSet_singleton a)
  have hae : ∀ a : α, (bernoulli p)⟦{y : ℤ → α | y 0 = a} | MeasurableSpace.comap F inferInstance⟧
      =ᵐ[bernoulli p]
      (bernoulli p)⟦{y : ℤ → α | y 0 = a} | pastSigma ⊔ MeasurableSpace.comap F inferInstance⟧ :=
    fun a => condExp_indicator_sup_indep pastSigma_le futureSigma_le
      (measurable_futureSigma_of_future hF hfut).comap_le (indep_pastSigma_futureSigma p) (hA a)
  refine integral_congr_ae ?_
  filter_upwards [ae_all_iff.2 hae] with x hx
  exact Finset.sum_congr rfl fun a _ => by rw [hx a]

/-- If every atom of a measurable partition lies in the cylinder of the first symbol of its
point, the conditional entropy vanishes: the conditional measure of `[x_0]` is one. -/
theorem condEntropy_eq_zero_of_subset_cylinder (μ : Measure (ℤ → α)) [IsFiniteMeasure μ]
    {ξ : (ℤ → α) → Set (ℤ → α)} (hξ : IsMeasurablePartition ξ)
    (h : ∀ x, ξ x ⊆ {y | y 0 = x 0}) : condEntropy μ ξ = 0 := by
  unfold condEntropy
  refine (integral_congr_ae ?_).trans (integral_zero _ _)
  filter_upwards [condMeas_atom μ hξ] with x hx
  have h1 : condMeas μ ξ x {y | y 0 = x 0} = 1 :=
    le_antisymm prob_le_one (hx.symm.le.trans (measure_mono (h x)))
  unfold condInfo
  rw [measureReal_def, h1, ENNReal.toReal_one, Real.log_one, neg_zero]

end Bernoulli

end BoxLike
