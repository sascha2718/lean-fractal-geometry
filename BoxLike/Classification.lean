module

/-
The classification of proximal tuples of `sec:irreducibility`: `thm:A_classification`. The
article cites the lemma from Bárány–Käenmäki–Rossi and Bárány–Käenmäki–Yu; this module proves
it. A tuple is a family `A : ι → Matrix (Fin 2) (Fin 2) ℝ` with `(A i).det ≠ 0` over an
arbitrary index type, vectors of the plane are functions `Fin 2 → ℝ`, and a line through the
origin is given by a non-zero vector spanning it.

* `TupleIrreducible`, `TupleStronglyIrreducible`, `TupleProximal`: the three notions of
  `sec:irreducibility`, on the level of spanning vectors.
* `SimultaneouslyBoxLike`, `SimultaneouslyTriangular`: the descriptions in items (2) and (3) of
  `thm:A_classification`, through a change of basis `P⁻¹ A_i P`.
* `colMat`, `conj_colMat`: the matrix of a linear map in a basis `x, y` of the plane.
* `MapsLines`, `MapsLines.exists_pow_mulVec_eq_smul`: a matrix of the semigroup maps a finite
  invariant set of lines into itself, and a power of it fixes any given line of the set.
* `pow_eq_smul_add_smul`, `IsProximalMatrix.exists_mulVec_eq_smul_of_pow`: by Cayley–Hamilton
  an eigenvector of a power of a proximal matrix is an eigenvector of the matrix.
* `TupleStronglyIrreducible.tupleIrreducible`, `tuple_trichotomy`: strongly irreducible tuples
  are irreducible, so exactly one of the three cases holds for every tuple.
* `not_tupleIrreducible_iff_simultaneouslyTriangular`: item (3), for every tuple.
* `simultaneouslyBoxLike_of_proximal`, `SimultaneouslyBoxLike.tupleIrreducible`,
  `SimultaneouslyBoxLike.not_tupleStronglyIrreducible`, `simultaneouslyBoxLike_iff`: item (2),
  for proximal tuples of invertible matrices.
* `tuple_classification`: `thm:A_classification`.
* `IsLine`, `tupleIrreducible_iff_lines`, `tupleStronglyIrreducible_iff_lines`: the two notions
  of irreducibility in the article's form, with sets `𝒱` of lines and `A_i 𝒱 = 𝒱`.
* `simultaneouslyBoxLike_swap`, `not_tupleIrreducible_swap`, `tupleIrreducible_rotThree`,
  `not_tupleStronglyIrreducible_rotThree`, `not_simultaneouslyBoxLike_rotThree`: without
  proximality both directions of the description in item (2) fail.
* `System.irreducible_iff_tupleIrreducible`, `System.proximal_iff_tupleProximal`,
  `System.not_tupleStronglyIrreducible`, `System.irreducible_and_not_stronglyIrreducible`: a
  proximal box-like tuple with rotations is in case (2).
-/
public import BoxLike.BoxLikeMatrix
public import BoxLike.Proximal
public import Mathlib.Data.Fintype.Pigeonhole
public import Mathlib.LinearAlgebra.Matrix.Nondegenerate
public import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
public import Mathlib.LinearAlgebra.Matrix.ToLin
public import Mathlib.Tactic.FieldSimp
public import Mathlib.Tactic.Module

@[expose] public section

namespace BoxLike

open Matrix

variable {ι : Type*}

/-! ### The notions of `sec:irreducibility` -/

/-- The tuple `𝖠` is irreducible (`sec:irreducibility`, tex lines 641 to 642): no line through
the origin is invariant under every `A_i`. A line is given by a non-zero vector `v` spanning
it, and `A_i v = c v` says that `A_i` maps the line into itself. For `S : System ι` this is
`System.Irreducible`. The form with lines as subspaces and `A_i V = V` is
`tupleIrreducible_iff_lines`. -/
def TupleIrreducible (A : ι → Matrix (Fin 2) (Fin 2) ℝ) : Prop :=
  ¬ ∃ v : Fin 2 → ℝ, v ≠ 0 ∧ ∀ i, ∃ c : ℝ, A i *ᵥ v = c • v

/-- The tuple `𝖠` is strongly irreducible (`sec:irreducibility`, tex lines 643 to 644): no
non-empty finite set of lines through the origin is invariant under every `A_i`. The lines are
spanned by the non-zero vectors of a finite set `s`, and `A_i v = c w` with `w ∈ s` says that
`A_i` maps the line of `v` into the line of `w`. The form with sets `𝒱` of lines and
`A_i 𝒱 = 𝒱` is `tupleStronglyIrreducible_iff_lines`. -/
def TupleStronglyIrreducible (A : ι → Matrix (Fin 2) (Fin 2) ℝ) : Prop :=
  ¬ ∃ s : Finset (Fin 2 → ℝ), s.Nonempty ∧ (∀ v ∈ s, v ≠ 0) ∧
    ∀ i, ∀ v ∈ s, ∃ w ∈ s, ∃ c : ℝ, A i *ᵥ v = c • w

/-- The tuple `𝖠` is proximal (`sec:irreducibility`, tex lines 644 to 646): the semigroup
generated by `𝖠` contains a proximal matrix, that is, some product `A_{i_1} ⋯ A_{i_n}` with
`n ≥ 1` is proximal. For `S : System ι` this is `System.Proximal`. -/
def TupleProximal (A : ι → Matrix (Fin 2) (Fin 2) ℝ) : Prop :=
  ∃ w : List ι, w ≠ [] ∧ IsProximalMatrix (w.map A).prod

/-- The description in item (2) of `thm:A_classification`: in some basis, the columns of `P`,
the matrices of `𝖠` are simultaneously diagonal or anti-diagonal, with at least one
anti-diagonal matrix. -/
def SimultaneouslyBoxLike (A : ι → Matrix (Fin 2) (Fin 2) ℝ) : Prop :=
  ∃ P : Matrix (Fin 2) (Fin 2) ℝ, P.det ≠ 0 ∧
    (∀ i, ∃ c : ZMod 2, ∃ a b : ℝ, P⁻¹ * A i * P = boxMat c a b) ∧
    ∃ i, ∃ a b : ℝ, P⁻¹ * A i * P = boxMat 1 a b

/-- The description in item (3) of `thm:A_classification`: in some basis, the columns of `P`,
the matrices of `𝖠` are simultaneously upper triangular. -/
def SimultaneouslyTriangular (A : ι → Matrix (Fin 2) (Fin 2) ℝ) : Prop :=
  ∃ P : Matrix (Fin 2) (Fin 2) ℝ, P.det ≠ 0 ∧ ∀ i, (P⁻¹ * A i * P) 1 0 = 0

/-! ### Bases of the plane -/

/-- The matrix with columns `x` and `y`. Its determinant is non-zero exactly when `x, y` is a
basis of the plane. -/
def colMat (x y : Fin 2 → ℝ) : Matrix (Fin 2) (Fin 2) ℝ := !![x 0, y 0; x 1, y 1]

/-- The determinant of `colMat x y`. -/
theorem det_colMat (x y : Fin 2 → ℝ) : (colMat x y).det = x 0 * y 1 - y 0 * x 1 :=
  Matrix.det_fin_two_of _ _ _ _

/-- The matrix `colMat x y` maps the coordinates `u` to the vector `u_0 x + u_1 y`. -/
theorem colMat_mulVec (x y u : Fin 2 → ℝ) : colMat x y *ᵥ u = u 0 • x + u 1 • y := by
  ext j
  fin_cases j <;> simp [colMat, Matrix.mulVec, dotProduct, Fin.sum_univ_two] <;> ring

/-- The columns of `M * colMat x y` are `M x` and `M y`. -/
theorem mul_colMat (M : Matrix (Fin 2) (Fin 2) ℝ) (x y : Fin 2 → ℝ) :
    M * colMat x y = colMat (M *ᵥ x) (M *ᵥ y) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [colMat, Matrix.mul_apply, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

/-- The columns of `colMat x y * N` are the combinations of `x` and `y` with the columns of `N`
as coefficients. -/
theorem colMat_mul (x y : Fin 2 → ℝ) (p q r t : ℝ) :
    colMat x y * !![p, q; r, t] = colMat (p • x + r • y) (q • x + t • y) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [colMat, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

/-- The matrix of `M` in the basis `x, y`: if `M x = p x + r y` and `M y = q x + t y`, then
`P⁻¹ M P` has the columns `(p, r)` and `(q, t)`, where `P = colMat x y`. -/
theorem conj_colMat {x y : Fin 2 → ℝ} (h : (colMat x y).det ≠ 0)
    {M : Matrix (Fin 2) (Fin 2) ℝ} {p q r t : ℝ} (hx : M *ᵥ x = p • x + r • y)
    (hy : M *ᵥ y = q • x + t • y) : (colMat x y)⁻¹ * M * colMat x y = !![p, q; r, t] := by
  rw [Matrix.mul_assoc, mul_colMat, hx, hy, ← colMat_mul, ← Matrix.mul_assoc,
    Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.2 h), Matrix.one_mul]

/-- A basis `x, y` spans the plane. -/
theorem exists_eq_smul_add_smul {x y : Fin 2 → ℝ} (h : (colMat x y).det ≠ 0) (v : Fin 2 → ℝ) :
    ∃ α β : ℝ, v = α • x + β • y := by
  refine ⟨((colMat x y)⁻¹ *ᵥ v) 0, ((colMat x y)⁻¹ *ᵥ v) 1, ?_⟩
  rw [← colMat_mulVec, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.2 h),
    Matrix.one_mulVec]

/-- A basis `x, y` is linearly independent. -/
theorem eq_zero_of_smul_add_smul_eq_zero {x y : Fin 2 → ℝ} (h : (colMat x y).det ≠ 0)
    {e f : ℝ} (hef : e • x + f • y = 0) : e = 0 ∧ f = 0 := by
  have h0 : colMat x y *ᵥ ![e, f] = 0 := by rw [colMat_mulVec]; simpa using hef
  have h1 := Matrix.eq_zero_of_mulVec_eq_zero h h0
  exact ⟨by simpa using congrFun h1 0, by simpa using congrFun h1 1⟩

/-- If `x ≠ 0` and `x, y` is not a basis, then `y` lies on the line of `x`. -/
theorem exists_eq_smul_of_det_colMat_eq_zero {x y : Fin 2 → ℝ} (hx : x ≠ 0)
    (h : (colMat x y).det = 0) : ∃ d : ℝ, y = d • x := by
  rw [det_colMat] at h
  by_cases h0 : x 0 = 0
  · have h1 : x 1 ≠ 0 := by
      intro h1
      apply hx
      ext j
      fin_cases j <;> simp [h0, h1]
    refine ⟨y 1 / x 1, ?_⟩
    ext j
    fin_cases j
    · simp only [Fin.zero_eta, Pi.smul_apply, smul_eq_mul]
      rw [h0] at h ⊢
      have h3 : y 0 * x 1 = 0 := by linarith
      rcases mul_eq_zero.1 h3 with h2 | h2
      · rw [h2]; simp
      · exact absurd h2 h1
    · simp only [Fin.mk_one, Pi.smul_apply, smul_eq_mul]
      field_simp
  · refine ⟨y 0 / x 0, ?_⟩
    ext j
    fin_cases j
    · simp only [Fin.zero_eta, Pi.smul_apply, smul_eq_mul]
      field_simp
    · simp only [Fin.mk_one, Pi.smul_apply, smul_eq_mul]
      field_simp
      linarith

/-! ### Conjugation -/

/-- The action of `M` on `P u` is `P` applied to the action of `P⁻¹ M P` on `u`. -/
theorem mulVec_conj {P : Matrix (Fin 2) (Fin 2) ℝ} (hP : P.det ≠ 0)
    (M : Matrix (Fin 2) (Fin 2) ℝ) (u : Fin 2 → ℝ) :
    M *ᵥ (P *ᵥ u) = P *ᵥ ((P⁻¹ * M * P) *ᵥ u) := by
  rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, ← Matrix.mul_assoc, ← Matrix.mul_assoc,
    Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.2 hP), Matrix.one_mul]

/-- An invertible matrix maps non-zero vectors to non-zero vectors. -/
theorem mulVec_ne_zero_of_det_ne_zero {P : Matrix (Fin 2) (Fin 2) ℝ} (hP : P.det ≠ 0)
    {u : Fin 2 → ℝ} (hu : u ≠ 0) : P *ᵥ u ≠ 0 :=
  fun h => hu (Matrix.eq_zero_of_mulVec_eq_zero hP h)

/-- The trace is invariant under a change of basis. -/
theorem trace_inv_mul_mul {P : Matrix (Fin 2) (Fin 2) ℝ} (hP : P.det ≠ 0)
    (M : Matrix (Fin 2) (Fin 2) ℝ) : (P⁻¹ * M * P).trace = M.trace := by
  rw [Matrix.trace_mul_cycle, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.2 hP),
    Matrix.one_mul]

/-- The determinant is invariant under a change of basis. -/
theorem det_inv_mul_mul {P : Matrix (Fin 2) (Fin 2) ℝ} (hP : P.det ≠ 0)
    (M : Matrix (Fin 2) (Fin 2) ℝ) : (P⁻¹ * M * P).det = M.det :=
  Matrix.det_conj' ((Matrix.isUnit_iff_isUnit_det _).2 (isUnit_iff_ne_zero.2 hP)) M

/-- A change of basis commutes with products over words. -/
theorem conj_list_prod {P : Matrix (Fin 2) (Fin 2) ℝ} (hP : P.det ≠ 0)
    (A : ι → Matrix (Fin 2) (Fin 2) ℝ) (w : List ι) :
    P⁻¹ * (w.map A).prod * P = (w.map fun i => P⁻¹ * A i * P).prod := by
  have hPP := Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.2 hP)
  induction w with
  | nil =>
    rw [List.map_nil, List.prod_nil, List.map_nil, List.prod_nil, Matrix.mul_one,
      Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.2 hP)]
  | cons i w ih =>
    rw [List.map_cons, List.prod_cons, List.map_cons, List.prod_cons, ← ih]
    calc P⁻¹ * (A i * (w.map A).prod) * P
        = P⁻¹ * A i * (P * P⁻¹) * (w.map A).prod * P := by
          rw [hPP, Matrix.mul_one, ← Matrix.mul_assoc]
      _ = P⁻¹ * A i * P * (P⁻¹ * (w.map A).prod * P) := by simp only [Matrix.mul_assoc]

/-- Proximality of a matrix is invariant under a change of basis, since the trace and the
determinant are. -/
theorem IsProximalMatrix.conj {B P : Matrix (Fin 2) (Fin 2) ℝ} (hB : IsProximalMatrix B)
    (hP : P.det ≠ 0) : IsProximalMatrix (P⁻¹ * B * P) := by
  rw [isProximalMatrix_iff_trace_det] at hB ⊢
  obtain ⟨l₁, l₂, hne, htr, hdet⟩ := hB
  exact ⟨l₁, l₂, hne, by rw [trace_inv_mul_mul hP, htr], by rw [det_inv_mul_mul hP, hdet]⟩

/-- An invertible matrix does not map a basis `x, y` into a single line. -/
theorem false_of_mulVec_eq_smul {M : Matrix (Fin 2) (Fin 2) ℝ} (hM : M.det ≠ 0)
    {x y z : Fin 2 → ℝ} (hxy : (colMat x y).det ≠ 0) {p q : ℝ} (hx : M *ᵥ x = p • z)
    (hy : M *ᵥ y = q • z) : False := by
  have h1 : (M * colMat x y).det ≠ 0 := by
    rw [Matrix.det_mul]
    exact mul_ne_zero hM hxy
  rw [mul_colMat, hx, hy, det_colMat] at h1
  apply h1
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

/-- A product of invertible matrices is invertible. -/
theorem det_list_prod_ne_zero {A : ι → Matrix (Fin 2) (Fin 2) ℝ} (hdet : ∀ i, (A i).det ≠ 0)
    (w : List ι) : (w.map A).prod.det ≠ 0 := by
  induction w with
  | nil => simp
  | cons i w ih =>
    rw [List.map_cons, List.prod_cons, Matrix.det_mul]
    exact mul_ne_zero (hdet i) ih

/-- A common eigenvector of the matrices `A_i` is an eigenvector of every product `A_𝐢`. -/
theorem exists_list_prod_mulVec_eq_smul {A : ι → Matrix (Fin 2) (Fin 2) ℝ} {v : Fin 2 → ℝ}
    (h : ∀ i, ∃ c : ℝ, A i *ᵥ v = c • v) (w : List ι) :
    ∃ c : ℝ, (w.map A).prod *ᵥ v = c • v := by
  induction w with
  | nil => exact ⟨1, by rw [List.map_nil, List.prod_nil, Matrix.one_mulVec, one_smul]⟩
  | cons i w ih =>
    obtain ⟨c, hc⟩ := ih
    obtain ⟨d, hd⟩ := h i
    exact ⟨c * d, by
      rw [List.map_cons, List.prod_cons, ← Matrix.mulVec_mulVec, hc, Matrix.mulVec_smul, hd,
        smul_smul]⟩

/-- A product of diagonal and anti-diagonal matrices is diagonal or anti-diagonal, as in
`thm:box_like_sa`. -/
theorem exists_list_prod_eq_boxMat {N : ι → Matrix (Fin 2) (Fin 2) ℝ}
    (h : ∀ i, ∃ c : ZMod 2, ∃ a b : ℝ, N i = boxMat c a b) (w : List ι) :
    ∃ c : ZMod 2, ∃ a b : ℝ, (w.map N).prod = boxMat c a b := by
  induction w with
  | nil => exact ⟨0, 1, 1, by ext i j; fin_cases i <;> fin_cases j <;> simp⟩
  | cons i w ih =>
    obtain ⟨c, a, b, hc⟩ := ih
    obtain ⟨c', a', b', hc'⟩ := h i
    exact ⟨_, _, _, by rw [List.map_cons, List.prod_cons, hc, hc', boxMat_mul]⟩

/-! ### Invariant finite sets of lines -/

/-- The matrix `M` maps the union of the lines spanned by the vectors of `s` into itself: the
condition on each `A_i` in `TupleStronglyIrreducible`. -/
def MapsLines (s : Finset (Fin 2 → ℝ)) (M : Matrix (Fin 2) (Fin 2) ℝ) : Prop :=
  ∀ v ∈ s, ∃ w ∈ s, ∃ c : ℝ, M *ᵥ v = c • w

/-- The identity maps every set of lines into itself. -/
theorem MapsLines.one (s : Finset (Fin 2 → ℝ)) : MapsLines s 1 := fun v hv =>
  ⟨v, hv, 1, by rw [Matrix.one_mulVec, one_smul]⟩

/-- The matrices that map a set of lines into itself are closed under products. -/
theorem MapsLines.mul {s : Finset (Fin 2 → ℝ)} {M N : Matrix (Fin 2) (Fin 2) ℝ}
    (hM : MapsLines s M) (hN : MapsLines s N) : MapsLines s (M * N) := by
  intro v hv
  obtain ⟨w, hw, c, hc⟩ := hN v hv
  obtain ⟨u, hu, d, hd⟩ := hM w hw
  exact ⟨u, hu, c * d, by rw [← Matrix.mulVec_mulVec, hc, Matrix.mulVec_smul, hd, smul_smul]⟩

/-- A set of lines invariant under every `A_i` is invariant under every product `A_𝐢`. -/
theorem MapsLines.list_prod {s : Finset (Fin 2 → ℝ)} {A : ι → Matrix (Fin 2) (Fin 2) ℝ}
    (h : ∀ i, MapsLines s (A i)) (w : List ι) : MapsLines s (w.map A).prod := by
  induction w with
  | nil => exact MapsLines.one s
  | cons i w ih =>
    rw [List.map_cons, List.prod_cons]
    exact (h i).mul ih

/-- A set of lines invariant under `M` is invariant under every power of `M`. -/
theorem MapsLines.pow {s : Finset (Fin 2 → ℝ)} {M : Matrix (Fin 2) (Fin 2) ℝ}
    (h : MapsLines s M) (n : ℕ) : MapsLines s (M ^ n) := by
  induction n with
  | zero => rw [pow_zero]; exact MapsLines.one s
  | succ n ih => rw [pow_succ]; exact ih.mul h

/-- An invertible matrix `B` that maps a finite set of lines into itself has, for every line of
the set, a power `B^k` with `k ≥ 1` that fixes this line. By the pigeonhole principle two of
the lines `B^n v`, `B^m v` with `n < m` agree, and `B^n` is injective, so `B^{m-n}` fixes the
line of `v`. This is the step "a power of `B` fixes every line" in the proof of
`thm:A_classification`. -/
theorem MapsLines.exists_pow_mulVec_eq_smul {s : Finset (Fin 2 → ℝ)}
    {B : Matrix (Fin 2) (Fin 2) ℝ} (h : MapsLines s B) (hs0 : ∀ v ∈ s, v ≠ 0)
    (hB : B.det ≠ 0) {v : Fin 2 → ℝ} (hv : v ∈ s) :
    ∃ k : ℕ, 0 < k ∧ ∃ c : ℝ, (B ^ k) *ᵥ v = c • v := by
  have hpow := fun n => h.pow n v hv
  choose f hf c hc using hpow
  have hdetpow : ∀ n, (B ^ n).det ≠ 0 := fun n => by
    rw [Matrix.det_pow]; exact pow_ne_zero n hB
  have hc0 : ∀ n, c n ≠ 0 := by
    intro n hn
    have h0 : (B ^ n) *ᵥ v = 0 := by rw [hc n, hn, zero_smul]
    exact hs0 v hv (Matrix.eq_zero_of_mulVec_eq_zero (hdetpow n) h0)
  have key : ∀ n m, n < m → f n = f m → ∃ k : ℕ, 0 < k ∧ ∃ c : ℝ, (B ^ k) *ᵥ v = c • v := by
    intro n m hnm hfeq
    refine ⟨m - n, Nat.sub_pos_of_lt hnm, c m / c n, ?_⟩
    have h1 : (B ^ n) *ᵥ ((B ^ (m - n)) *ᵥ v - (c m / c n) • v) = 0 := by
      rw [Matrix.mulVec_sub, Matrix.mulVec_mulVec, ← pow_add, Nat.add_sub_cancel' hnm.le,
        Matrix.mulVec_smul, hc m, hc n, ← hfeq, smul_smul, div_mul_cancel₀ _ (hc0 n), sub_self]
    exact sub_eq_zero.1 (Matrix.eq_zero_of_mulVec_eq_zero (hdetpow n) h1)
  obtain ⟨n, m, hnm, hfeq⟩ :=
    Finite.exists_ne_map_eq_of_infinite (fun n => (⟨f n, hf n⟩ : {x // x ∈ s}))
  have hfeq' : f n = f m := congrArg Subtype.val hfeq
  rcases lt_or_gt_of_ne hnm with hlt | hlt
  · exact key n m hlt hfeq'
  · exact key m n hlt hfeq'.symm

/-! ### Eigenvectors of powers of a proximal matrix -/

/-- The theorem of Cayley–Hamilton for a `2 × 2` matrix: `B² = (tr B) B - (det B) I`. -/
theorem mul_self_eq_trace_smul_sub (B : Matrix (Fin 2) (Fin 2) ℝ) :
    B * B = B.trace • B - B.det • (1 : Matrix (Fin 2) (Fin 2) ℝ) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two, Matrix.trace_fin_two, Matrix.det_fin_two] <;> ring

/-- If `B` has the eigenvalues `l₁, l₂`, then `B^k = p B + q I` with
`p (l₁ - l₂) = l₁^k - l₂^k` and `q (l₁ - l₂) = l₁ l₂^k - l₂ l₁^k`. -/
theorem pow_eq_smul_add_smul {B : Matrix (Fin 2) (Fin 2) ℝ} {l₁ l₂ : ℝ}
    (htr : B.trace = l₁ + l₂) (hdet : B.det = l₁ * l₂) (k : ℕ) :
    ∃ p q : ℝ, B ^ k = p • B + q • (1 : Matrix (Fin 2) (Fin 2) ℝ) ∧
      p * (l₁ - l₂) = l₁ ^ k - l₂ ^ k ∧ q * (l₁ - l₂) = l₁ * l₂ ^ k - l₂ * l₁ ^ k := by
  induction k with
  | zero => exact ⟨0, 1, by simp, by simp, by simp⟩
  | succ k ih =>
    obtain ⟨p, q, hpq, hp, hq⟩ := ih
    refine ⟨p * (l₁ + l₂) + q, -(p * (l₁ * l₂)), ?_, ?_, ?_⟩
    · rw [pow_succ, hpq, Matrix.add_mul, Matrix.smul_mul, Matrix.smul_mul, Matrix.one_mul,
        mul_self_eq_trace_smul_sub, htr, hdet]
      module
    · linear_combination (l₁ + l₂) * hp + hq
    · linear_combination (-(l₁ * l₂)) * hp

/-- An eigenvector of a power `B^k`, `k ≥ 1`, of a proximal matrix `B` is an eigenvector of
`B`: in `B^k = p B + q I` the coefficient `p` is non-zero, since `|l₁| ≠ |l₂|` gives
`l₁^k ≠ l₂^k`. This is the step "every line fixed by `B^k` is an eigenline of `B`" in the proof
of `thm:A_classification`. -/
theorem IsProximalMatrix.exists_mulVec_eq_smul_of_pow {B : Matrix (Fin 2) (Fin 2) ℝ}
    (hB : IsProximalMatrix B) {k : ℕ} (hk : 0 < k) {v : Fin 2 → ℝ} {c : ℝ}
    (h : (B ^ k) *ᵥ v = c • v) : ∃ μ : ℝ, B *ᵥ v = μ • v := by
  obtain ⟨l₁, l₂, hne, htr, hdet⟩ := isProximalMatrix_iff_trace_det.1 hB
  obtain ⟨p, q, hpq, hp, -⟩ := pow_eq_smul_add_smul htr hdet k
  have hp0 : p ≠ 0 := by
    rintro rfl
    rw [zero_mul] at hp
    have h1 : |l₁| ^ k = |l₂| ^ k := by rw [← abs_pow, ← abs_pow, sub_eq_zero.1 hp.symm]
    exact hne ((pow_left_inj₀ (abs_nonneg _) (abs_nonneg _) hk.ne').1 h1)
  refine ⟨(c - q) / p, ?_⟩
  rw [hpq, Matrix.add_mulVec, Matrix.smul_mulVec, Matrix.smul_mulVec, Matrix.one_mulVec] at h
  have h2 : p • (B *ᵥ v) = (c - q) • v := by
    rw [sub_smul, ← h, add_sub_cancel_right]
  rw [div_eq_inv_mul, ← smul_smul, ← h2, smul_smul, inv_mul_cancel₀ hp0, one_smul]

/-! ### The classification -/

/-- A strongly irreducible tuple is irreducible: an invariant line is an invariant set of one
line. The three cases of `thm:A_classification` are therefore exhaustive and exclusive. -/
theorem TupleStronglyIrreducible.tupleIrreducible {A : ι → Matrix (Fin 2) (Fin 2) ℝ}
    (h : TupleStronglyIrreducible A) : TupleIrreducible A := by
  rintro ⟨v, hv, hline⟩
  refine h ⟨{v}, Finset.singleton_nonempty v, fun u hu => ?_, fun i u hu => ?_⟩
  · rw [Finset.mem_singleton.1 hu]
    exact hv
  · rw [Finset.mem_singleton.1 hu]
    obtain ⟨c, hc⟩ := hline i
    exact ⟨v, Finset.mem_singleton_self v, c, hc⟩

/-- Every tuple is in exactly one of the three cases of `thm:A_classification`: strongly
irreducible, irreducible and not strongly irreducible, or reducible. The statement needs
neither proximality nor invertibility. -/
theorem tuple_trichotomy (A : ι → Matrix (Fin 2) (Fin 2) ℝ) :
    (TupleStronglyIrreducible A ∧ TupleIrreducible A) ∨
      (¬ TupleStronglyIrreducible A ∧ TupleIrreducible A) ∨
      (¬ TupleStronglyIrreducible A ∧ ¬ TupleIrreducible A) := by
  by_cases hsi : TupleStronglyIrreducible A
  · exact Or.inl ⟨hsi, hsi.tupleIrreducible⟩
  · by_cases hi : TupleIrreducible A
    · exact Or.inr (Or.inl ⟨hsi, hi⟩)
    · exact Or.inr (Or.inr ⟨hsi, hi⟩)

/-- Item (3) of `thm:A_classification`: a tuple is reducible if and only if its matrices are
simultaneously upper triangular in some basis. A common eigenvector `v` is completed to the
basis `v, (-v_1, v_0)`; conversely the first vector of the basis is a common eigenvector. The
equivalence holds for every tuple. -/
theorem not_tupleIrreducible_iff_simultaneouslyTriangular
    {A : ι → Matrix (Fin 2) (Fin 2) ℝ} :
    ¬ TupleIrreducible A ↔ SimultaneouslyTriangular A := by
  constructor
  · intro h
    obtain ⟨v, hv, hline⟩ := not_not.1 h
    have hdetv : (colMat v ![-v 1, v 0]).det ≠ 0 := by
      rw [det_colMat]
      intro h0
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h0
      have h1 : v 0 = 0 := by nlinarith [sq_nonneg (v 0), sq_nonneg (v 1)]
      have h2 : v 1 = 0 := by nlinarith [sq_nonneg (v 0), sq_nonneg (v 1)]
      exact hv (by ext j; fin_cases j <;> simp [h1, h2])
    refine ⟨_, hdetv, fun i => ?_⟩
    obtain ⟨c, hc⟩ := hline i
    obtain ⟨q, t, hqt⟩ := exists_eq_smul_add_smul hdetv (A i *ᵥ ![-v 1, v 0])
    rw [conj_colMat hdetv (p := c) (r := 0) (by rw [hc, zero_smul, add_zero]) hqt]
    simp
  · rintro ⟨P, hP, h⟩
    refine not_not.2 ⟨P *ᵥ ![1, 0], mulVec_ne_zero_of_det_ne_zero hP ?_,
      fun i => ⟨(P⁻¹ * A i * P) 0 0, ?_⟩⟩
    · intro h0
      simpa using congrFun h0 0
    · rw [mulVec_conj hP, ← Matrix.mulVec_smul]
      congr 1
      ext j
      fin_cases j
      · simp [Matrix.mulVec, dotProduct, Fin.sum_univ_two]
      · simp [Matrix.mulVec, dotProduct, Fin.sum_univ_two, h i]

/-- The key step of `thm:A_classification`: a proximal tuple of invertible matrices that is
irreducible and not strongly irreducible is simultaneously diagonal or anti-diagonal in some
basis, with at least one anti-diagonal matrix. Let `s` span a finite invariant set of lines and
let `B` be a proximal matrix of the semigroup. Every line of `s` is fixed by a power of `B`, so
it is an eigenline of `B`. By irreducibility `s` contains a basis `x, y`; in this basis `B` is
diagonal with entries of distinct moduli, so every line of `s` is the line of `x` or of `y`.
Each `A_i` maps the two lines to the two lines, and it does not map both to the same line since
it is invertible; hence it is diagonal or anti-diagonal in the basis `x, y`. If every `A_i`
were diagonal, the line of `x` would be invariant. -/
theorem simultaneouslyBoxLike_of_proximal {A : ι → Matrix (Fin 2) (Fin 2) ℝ}
    (hdet : ∀ i, (A i).det ≠ 0) (hprox : TupleProximal A) (hirr : TupleIrreducible A)
    (hnsi : ¬ TupleStronglyIrreducible A) : SimultaneouslyBoxLike A := by
  obtain ⟨s, hne, hs0, hinv⟩ := not_not.1 hnsi
  obtain ⟨w, -, hB⟩ := hprox
  have hBs : MapsLines s (w.map A).prod := MapsLines.list_prod hinv w
  -- Every vector of `s` is an eigenvector of `B`.
  have heig : ∀ v ∈ s, ∃ μ : ℝ, (w.map A).prod *ᵥ v = μ • v := fun v hv => by
    obtain ⟨k, hk, c, hc⟩ :=
      hBs.exists_pow_mulVec_eq_smul hs0 (det_list_prod_ne_zero hdet w) hv
    exact hB.exists_mulVec_eq_smul_of_pow hk hc
  -- By irreducibility `s` contains a basis.
  obtain ⟨x, hx⟩ := hne
  obtain ⟨y, hy, hxy⟩ : ∃ y ∈ s, (colMat x y).det ≠ 0 := by
    by_contra hcon
    push Not at hcon
    refine hirr ⟨x, hs0 x hx, fun i => ?_⟩
    obtain ⟨u, hu, c, hc⟩ := hinv i x hx
    obtain ⟨d, hd⟩ := exists_eq_smul_of_det_colMat_eq_zero (hs0 x hx) (hcon u hu)
    exact ⟨c * d, by rw [hc, hd, smul_smul]⟩
  -- In this basis `B` is diagonal with entries of distinct moduli.
  obtain ⟨μ₁, hμ₁⟩ := heig x hx
  obtain ⟨μ₂, hμ₂⟩ := heig y hy
  have hBconj : (colMat x y)⁻¹ * (w.map A).prod * colMat x y = boxMat 0 μ₁ μ₂ := by
    rw [boxMat_zero]
    exact conj_colMat hxy (by rw [hμ₁, zero_smul, add_zero]) (by rw [hμ₂, zero_smul, zero_add])
  have hμ : |μ₁| ≠ |μ₂| := isProximalMatrix_boxMat_zero.1 (hBconj ▸ hB.conj hxy)
  -- Every vector of `s` lies on the line of `x` or on the line of `y`.
  have haxis : ∀ v ∈ s, (∃ d : ℝ, v = d • x) ∨ ∃ d : ℝ, v = d • y := by
    intro v hv
    obtain ⟨μ, hμv⟩ := heig v hv
    obtain ⟨α, β, rfl⟩ := exists_eq_smul_add_smul hxy v
    rw [Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul, hμ₁, hμ₂] at hμv
    have h0 : (α * (μ₁ - μ)) • x + (β * (μ₂ - μ)) • y = 0 := by
      ext j
      have hj := congrFun hμv j
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at hj ⊢
      linear_combination hj
    obtain ⟨h1, h2⟩ := eq_zero_of_smul_add_smul_eq_zero hxy h0
    rcases mul_eq_zero.1 h1 with hα | hα
    · exact Or.inr ⟨β, by rw [hα, zero_smul, zero_add]⟩
    · rcases mul_eq_zero.1 h2 with hβ | hβ
      · exact Or.inl ⟨α, by rw [hβ, zero_smul, add_zero]⟩
      · exact absurd (by rw [sub_eq_zero.1 hα, sub_eq_zero.1 hβ]) hμ
  have himg : ∀ i, ∀ v ∈ s, (∃ d : ℝ, A i *ᵥ v = d • x) ∨ ∃ d : ℝ, A i *ᵥ v = d • y := by
    intro i v hv
    obtain ⟨u, hu, c, hc⟩ := hinv i v hv
    rcases haxis u hu with ⟨d, hd⟩ | ⟨d, hd⟩
    · exact Or.inl ⟨c * d, by rw [hc, hd, smul_smul]⟩
    · exact Or.inr ⟨c * d, by rw [hc, hd, smul_smul]⟩
  -- Each `A_i` fixes the two lines or exchanges them.
  have hdich : ∀ i, (∃ p t : ℝ, A i *ᵥ x = p • x ∧ A i *ᵥ y = t • y) ∨
      ∃ q r : ℝ, A i *ᵥ x = r • y ∧ A i *ᵥ y = q • x := by
    intro i
    rcases himg i x hx with ⟨p, hp⟩ | ⟨r, hr⟩ <;> rcases himg i y hy with ⟨q, hq⟩ | ⟨t, ht⟩
    · exact (false_of_mulVec_eq_smul (hdet i) hxy hp hq).elim
    · exact Or.inl ⟨p, t, hp, ht⟩
    · exact Or.inr ⟨q, r, hr, hq⟩
    · exact (false_of_mulVec_eq_smul (hdet i) hxy hr ht).elim
  have hanti : ∀ i q r, A i *ᵥ x = r • y → A i *ᵥ y = q • x →
      (colMat x y)⁻¹ * A i * colMat x y = boxMat 1 q r := by
    intro i q r hr hq
    rw [boxMat_one]
    exact conj_colMat hxy (by rw [hr, zero_smul, zero_add]) (by rw [hq, zero_smul, add_zero])
  refine ⟨colMat x y, hxy, fun i => ?_, ?_⟩
  · rcases hdich i with ⟨p, t, hp, ht⟩ | ⟨q, r, hr, hq⟩
    · refine ⟨0, p, t, ?_⟩
      rw [boxMat_zero]
      exact conj_colMat hxy (by rw [hp, zero_smul, add_zero]) (by rw [ht, zero_smul, zero_add])
    · exact ⟨1, q, r, hanti i q r hr hq⟩
  · by_contra hcon
    push Not at hcon
    refine hirr ⟨x, hs0 x hx, fun i => ?_⟩
    rcases hdich i with ⟨p, t, hp, -⟩ | ⟨q, r, hr, hq⟩
    · exact ⟨p, hp⟩
    · exact absurd (hanti i q r hr hq) (hcon i q r)

/-- A tuple whose matrices are simultaneously diagonal or anti-diagonal in some basis is not
strongly irreducible: the two lines spanned by the vectors of the basis form an invariant set.
This is the observation of tex lines 378 to 378 and 505 to 506. -/
theorem not_tupleStronglyIrreducible_of_conj_boxMat {A : ι → Matrix (Fin 2) (Fin 2) ℝ}
    {P : Matrix (Fin 2) (Fin 2) ℝ} (hP : P.det ≠ 0)
    (hbox : ∀ i, ∃ c : ZMod 2, ∃ a b : ℝ, P⁻¹ * A i * P = boxMat c a b) :
    ¬ TupleStronglyIrreducible A := by
  classical
  have he1 : (![1, 0] : Fin 2 → ℝ) ≠ 0 := fun h => by simpa using congrFun h 0
  have he2 : (![0, 1] : Fin 2 → ℝ) ≠ 0 := fun h => by simpa using congrFun h 1
  refine not_not.2 ⟨{P *ᵥ ![1, 0], P *ᵥ ![0, 1]}, ⟨_, Finset.mem_insert_self _ _⟩, ?_, ?_⟩
  · intro v hv
    rw [Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl
    · exact mulVec_ne_zero_of_det_ne_zero hP he1
    · exact mulVec_ne_zero_of_det_ne_zero hP he2
  · intro i v hv
    obtain ⟨c, a, b, hc⟩ := hbox i
    have hm1 : P *ᵥ ![1, 0] ∈ ({P *ᵥ ![1, 0], P *ᵥ ![0, 1]} : Finset (Fin 2 → ℝ)) :=
      Finset.mem_insert_self _ _
    have hm2 : P *ᵥ ![0, 1] ∈ ({P *ᵥ ![1, 0], P *ᵥ ![0, 1]} : Finset (Fin 2 → ℝ)) :=
      Finset.mem_insert_of_mem (Finset.mem_singleton_self _)
    rw [Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl <;> rw [mulVec_conj hP, hc, boxMat_mulVec] <;>
      rcases zmod_two_cases c with rfl | rfl
    · refine ⟨_, hm1, a, ?_⟩
      rw [← Matrix.mulVec_smul]
      congr 1
      ext j
      fin_cases j <;> simp
    · refine ⟨_, hm2, b, ?_⟩
      rw [← Matrix.mulVec_smul]
      congr 1
      ext j
      fin_cases j <;> simp
    · refine ⟨_, hm2, b, ?_⟩
      rw [← Matrix.mulVec_smul]
      congr 1
      ext j
      fin_cases j <;> simp
    · refine ⟨_, hm1, a, ?_⟩
      rw [← Matrix.mulVec_smul]
      congr 1
      ext j
      fin_cases j <;> simp

/-- A simultaneously diagonal or anti-diagonal tuple is not strongly irreducible. The statement
needs neither proximality nor invertibility. -/
theorem SimultaneouslyBoxLike.not_tupleStronglyIrreducible
    {A : ι → Matrix (Fin 2) (Fin 2) ℝ} (h : SimultaneouslyBoxLike A) :
    ¬ TupleStronglyIrreducible A := by
  obtain ⟨P, hP, hbox, -⟩ := h
  exact not_tupleStronglyIrreducible_of_conj_boxMat hP hbox

/-- A proximal tuple of invertible matrices that is simultaneously diagonal or anti-diagonal in
some basis, with at least one anti-diagonal matrix, is irreducible. In the new coordinates a
common eigenvector `u` has two non-zero entries, since the invertible anti-diagonal matrix
exchanges the axes. It is an eigenvector of the proximal product, which is diagonal with
entries of distinct moduli, and the eigenvectors of such a matrix lie on the axes. Without
proximality the statement fails: `not_tupleIrreducible_swap`. -/
theorem SimultaneouslyBoxLike.tupleIrreducible {A : ι → Matrix (Fin 2) (Fin 2) ℝ}
    (h : SimultaneouslyBoxLike A) (hdet : ∀ i, (A i).det ≠ 0) (hprox : TupleProximal A) :
    TupleIrreducible A := by
  obtain ⟨P, hP, hbox, i₁, a₁, b₁, h₁⟩ := h
  rintro ⟨v, hv, hline⟩
  obtain ⟨w, -, hB⟩ := hprox
  have hPv : P *ᵥ (P⁻¹ *ᵥ v) = v := by
    rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.2 hP),
      Matrix.one_mulVec]
  have hu0 : P⁻¹ *ᵥ v ≠ 0 := by
    intro h0
    apply hv
    rw [← hPv, h0, Matrix.mulVec_zero]
  have hline' : ∀ i, ∃ c : ℝ, (P⁻¹ * A i * P) *ᵥ (P⁻¹ *ᵥ v) = c • (P⁻¹ *ᵥ v) := by
    intro i
    obtain ⟨c, hc⟩ := hline i
    refine ⟨c, ?_⟩
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hPv, hc, Matrix.mulVec_smul]
  generalize P⁻¹ *ᵥ v = u at hu0 hline'
  obtain ⟨μ, hμ⟩ := exists_list_prod_mulVec_eq_smul hline' w
  obtain ⟨c, a, b, hcab⟩ := exists_list_prod_eq_boxMat hbox w
  have hprox' : IsProximalMatrix (boxMat c a b) := by
    rw [← hcab, ← conj_list_prod hP]
    exact hB.conj hP
  rcases zmod_two_cases c with rfl | rfl
  swap
  · exact not_isProximalMatrix_boxMat_one _ _ hprox'
  have hab := isProximalMatrix_boxMat_zero.1 hprox'
  obtain ⟨c₁, hc₁⟩ := hline' i₁
  rw [h₁, boxMat_mulVec] at hc₁
  rw [hcab, boxMat_mulVec] at hμ
  have hd : (P⁻¹ * A i₁ * P).det ≠ 0 := by
    rw [det_inv_mul_mul hP]
    exact hdet i₁
  rw [h₁, boxMat_one, Matrix.det_fin_two_of] at hd
  have ha₁ : a₁ ≠ 0 := fun h => hd (by rw [h]; ring)
  have hb₁ : b₁ ≠ 0 := fun h => hd (by rw [h]; ring)
  have e0 : a₁ * u 1 = c₁ * u 0 := by simpa using congrFun hc₁ 0
  have e1 : b₁ * u 0 = c₁ * u 1 := by simpa using congrFun hc₁ 1
  have f0 : a * u 0 = μ * u 0 := by simpa using congrFun hμ 0
  have f1 : b * u 1 = μ * u 1 := by simpa using congrFun hμ 1
  have hu0' : u 0 ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at e0
    have h1 : u 1 = 0 := (mul_eq_zero.1 e0).resolve_left ha₁
    exact hu0 (by ext j; fin_cases j <;> simp [h0, h1])
  have hu1' : u 1 ≠ 0 := by
    intro h1
    rw [h1, mul_zero] at e1
    have h0 : u 0 = 0 := (mul_eq_zero.1 e1).resolve_left hb₁
    exact hu0 (by ext j; fin_cases j <;> simp [h0, h1])
  exact hab (by rw [mul_right_cancel₀ hu0' f0, mul_right_cancel₀ hu1' f1])

/-- Item (2) of `thm:A_classification`: a proximal tuple of invertible matrices is irreducible
and not strongly irreducible if and only if its matrices are simultaneously diagonal or
anti-diagonal in some basis, with at least one anti-diagonal matrix. Both directions use
proximality. -/
theorem simultaneouslyBoxLike_iff {A : ι → Matrix (Fin 2) (Fin 2) ℝ}
    (hdet : ∀ i, (A i).det ≠ 0) (hprox : TupleProximal A) :
    SimultaneouslyBoxLike A ↔ TupleIrreducible A ∧ ¬ TupleStronglyIrreducible A :=
  ⟨fun h => ⟨h.tupleIrreducible hdet hprox, h.not_tupleStronglyIrreducible⟩,
    fun h => simultaneouslyBoxLike_of_proximal hdet hprox h.1 h.2⟩

/-- `thm:A_classification`: if `𝖠 ∈ GL_2(ℝ)^N` is proximal, then precisely one of the following
holds: `𝖠` is strongly irreducible; the matrices of `𝖠` are simultaneously diagonal or
anti-diagonal in some basis, with at least one anti-diagonal matrix; the matrices of `𝖠` are
simultaneously upper triangular in some basis. The second condition is equivalent to `𝖠` being
irreducible and not strongly irreducible, and the third to `𝖠` being reducible. The index type
is arbitrary. -/
theorem tuple_classification {A : ι → Matrix (Fin 2) (Fin 2) ℝ}
    (hdet : ∀ i, (A i).det ≠ 0) (hprox : TupleProximal A) :
    ((TupleStronglyIrreducible A ∧ ¬ SimultaneouslyBoxLike A ∧ ¬ SimultaneouslyTriangular A) ∨
      (¬ TupleStronglyIrreducible A ∧ SimultaneouslyBoxLike A ∧ ¬ SimultaneouslyTriangular A) ∨
      (¬ TupleStronglyIrreducible A ∧ ¬ SimultaneouslyBoxLike A ∧
        SimultaneouslyTriangular A)) ∧
    (SimultaneouslyBoxLike A ↔ TupleIrreducible A ∧ ¬ TupleStronglyIrreducible A) ∧
    (SimultaneouslyTriangular A ↔ ¬ TupleIrreducible A) := by
  have h2 := simultaneouslyBoxLike_iff hdet hprox
  have h3 := not_tupleIrreducible_iff_simultaneouslyTriangular (A := A)
  refine ⟨?_, h2, h3.symm⟩
  rcases tuple_trichotomy A with ⟨hsi, hi⟩ | ⟨hsi, hi⟩ | ⟨hsi, hi⟩
  · exact Or.inl ⟨hsi, fun h => (h2.1 h).2 hsi, fun h => h3.2 h hi⟩
  · exact Or.inr (Or.inl ⟨hsi, h2.2 ⟨hi, hsi⟩, fun h => h3.2 h hi⟩)
  · exact Or.inr (Or.inr ⟨hsi, fun h => hi (h2.1 h).1, h3.1 hi⟩)

/-- A tuple of diagonal matrices is reducible (tex line 663): the first axis is invariant. -/
theorem not_tupleIrreducible_of_diagonal {A : ι → Matrix (Fin 2) (Fin 2) ℝ}
    (h : ∀ i, ∃ a b : ℝ, A i = boxMat 0 a b) : ¬ TupleIrreducible A := by
  refine not_not.2 ⟨![1, 0], fun h0 => by simpa using congrFun h0 0, fun i => ?_⟩
  obtain ⟨a, b, hab⟩ := h i
  refine ⟨a, ?_⟩
  rw [hab, boxMat_mulVec]
  ext j
  fin_cases j <;> simp

/-! ### The projective formulation -/

/-- A line through the origin of the plane, that is, a point of the real projective line `ℝℙ¹`
of `sec:irreducibility`. -/
def IsLine (V : Submodule ℝ (Fin 2 → ℝ)) : Prop :=
  ∃ v : Fin 2 → ℝ, v ≠ 0 ∧ V = Submodule.span ℝ {v}

/-- The linear map of an invertible matrix is injective. -/
theorem toLin'_injective_of_det_ne_zero {M : Matrix (Fin 2) (Fin 2) ℝ} (hM : M.det ≠ 0) :
    Function.Injective (Matrix.toLin' M) := by
  intro x y h
  rw [Matrix.toLin'_apply, Matrix.toLin'_apply] at h
  exact sub_eq_zero.1
    (Matrix.eq_zero_of_mulVec_eq_zero hM (by rw [Matrix.mulVec_sub, h, sub_self]))

/-- The image of the span of `v` under `M` is the span of `M v`. -/
theorem map_span_singleton (M : Matrix (Fin 2) (Fin 2) ℝ) (v : Fin 2 → ℝ) :
    (Submodule.span ℝ {v}).map (Matrix.toLin' M) = Submodule.span ℝ {M *ᵥ v} := by
  rw [Submodule.map_span, Set.image_singleton, Matrix.toLin'_apply]

/-- If `M` is invertible, `v ≠ 0` and `M v = c w`, then `M` maps the line of `v` onto the line
of `w`. -/
theorem map_span_singleton_eq {M : Matrix (Fin 2) (Fin 2) ℝ} (hM : M.det ≠ 0)
    {v w : Fin 2 → ℝ} (hv : v ≠ 0) {c : ℝ} (h : M *ᵥ v = c • w) :
    (Submodule.span ℝ {v}).map (Matrix.toLin' M) = Submodule.span ℝ {w} := by
  have hc : c ≠ 0 := by
    rintro rfl
    rw [zero_smul] at h
    exact hv (Matrix.eq_zero_of_mulVec_eq_zero hM h)
  rw [map_span_singleton, h, Submodule.span_singleton_smul_eq (isUnit_iff_ne_zero.2 hc)]

/-- Irreducibility in the article's form (tex lines 641 to 642): for a tuple of invertible
matrices, `𝖠` is irreducible if and only if there is no line `V ∈ ℝℙ¹` with `A_i V = V` for
all `i`. -/
theorem tupleIrreducible_iff_lines {A : ι → Matrix (Fin 2) (Fin 2) ℝ}
    (hdet : ∀ i, (A i).det ≠ 0) :
    TupleIrreducible A ↔
      ¬ ∃ V : Submodule ℝ (Fin 2 → ℝ), IsLine V ∧ ∀ i, V.map (Matrix.toLin' (A i)) = V := by
  refine not_congr ⟨?_, ?_⟩
  · rintro ⟨v, hv, hline⟩
    refine ⟨Submodule.span ℝ {v}, ⟨v, hv, rfl⟩, fun i => ?_⟩
    obtain ⟨c, hc⟩ := hline i
    exact map_span_singleton_eq (hdet i) hv hc
  · rintro ⟨V, ⟨v, hv, rfl⟩, hV⟩
    refine ⟨v, hv, fun i => ?_⟩
    have hmem : A i *ᵥ v ∈ Submodule.span ℝ {v} := by
      have h := hV i
      rw [map_span_singleton] at h
      rw [← h]
      exact Submodule.mem_span_singleton_self _
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.1 hmem
    exact ⟨c, hc.symm⟩

/-- Strong irreducibility in the article's form (tex lines 643 to 644): for a tuple of
invertible matrices, `𝖠` is strongly irreducible if and only if there is no non-empty finite
set `𝒱 ⊂ ℝℙ¹` with `A_i 𝒱 = 𝒱` for all `i`. An injective map of a finite set into itself is
onto, so `A_i 𝒱 ⊆ 𝒱` gives `A_i 𝒱 = 𝒱`. -/
theorem tupleStronglyIrreducible_iff_lines {A : ι → Matrix (Fin 2) (Fin 2) ℝ}
    (hdet : ∀ i, (A i).det ≠ 0) :
    TupleStronglyIrreducible A ↔
      ¬ ∃ L : Set (Submodule ℝ (Fin 2 → ℝ)), L.Finite ∧ L.Nonempty ∧ (∀ V ∈ L, IsLine V) ∧
        ∀ i, Submodule.map (Matrix.toLin' (A i)) '' L = L := by
  classical
  refine not_congr ⟨?_, ?_⟩
  · rintro ⟨s, hne, hs0, hinv⟩
    have hmaps : ∀ i, Set.MapsTo (Submodule.map (Matrix.toLin' (A i)))
        ((fun v : Fin 2 → ℝ => Submodule.span ℝ {v}) '' (s : Set (Fin 2 → ℝ)))
        ((fun v : Fin 2 → ℝ => Submodule.span ℝ {v}) '' (s : Set (Fin 2 → ℝ))) := by
      rintro i _ ⟨v, hv, rfl⟩
      obtain ⟨w, hw, c, hc⟩ := hinv i v hv
      exact ⟨w, hw, (map_span_singleton_eq (hdet i) (hs0 v hv) hc).symm⟩
    refine ⟨(fun v => Submodule.span ℝ {v}) '' (s : Set (Fin 2 → ℝ)),
      s.finite_toSet.image _, (Finset.coe_nonempty.2 hne).image _, ?_, fun i => ?_⟩
    · rintro _ ⟨v, hv, rfl⟩
      exact ⟨v, hs0 v hv, rfl⟩
    · exact (((s.finite_toSet.image _).injOn_iff_bijOn_of_mapsTo (hmaps i)).1
        (Submodule.map_injective_of_injective
          (toLin'_injective_of_det_ne_zero (hdet i))).injOn).image_eq
  · rintro ⟨L, hfin, hne, hlines, hL⟩
    choose! g hg0 hg using hlines
    refine ⟨hfin.toFinset.image g, ?_, ?_, ?_⟩
    · obtain ⟨V, hV⟩ := hne
      exact ⟨g V, Finset.mem_image_of_mem g (hfin.mem_toFinset.2 hV)⟩
    · intro v hv
      obtain ⟨V, hV, rfl⟩ := Finset.mem_image.1 hv
      exact hg0 V (hfin.mem_toFinset.1 hV)
    · intro i v hv
      obtain ⟨V, hV, rfl⟩ := Finset.mem_image.1 hv
      have hVL := hfin.mem_toFinset.1 hV
      have hWL : V.map (Matrix.toLin' (A i)) ∈ L := (hL i).subset ⟨V, hVL, rfl⟩
      refine ⟨g (V.map (Matrix.toLin' (A i))),
        Finset.mem_image_of_mem g (hfin.mem_toFinset.2 hWL), ?_⟩
      have hgV : g V ∈ Submodule.span ℝ {g V} := Submodule.mem_span_singleton_self _
      rw [← hg V hVL] at hgV
      have hmem : A i *ᵥ g V ∈ V.map (Matrix.toLin' (A i)) := by
        rw [← Matrix.toLin'_apply]
        exact Submodule.mem_map_of_mem hgV
      rw [hg _ hWL] at hmem
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.1 hmem
      exact ⟨c, hc.symm⟩

/-! ### The role of proximality -/

/-- The tuple consisting of the coordinate swap is anti-diagonal in the standard basis. -/
theorem simultaneouslyBoxLike_swap : SimultaneouslyBoxLike fun _ : Unit => boxMat 1 1 1 :=
  ⟨1, by simp, fun _ => ⟨1, 1, 1, by rw [inv_one, Matrix.one_mul, Matrix.mul_one]⟩, (), 1, 1,
    by rw [inv_one, Matrix.one_mul, Matrix.mul_one]⟩

/-- The tuple consisting of the coordinate swap is reducible: the diagonal is invariant. The
description in item (2) of `thm:A_classification` therefore does not imply irreducibility
without proximality, and it does not exclude item (3). -/
theorem not_tupleIrreducible_swap : ¬ TupleIrreducible fun _ : Unit => boxMat 1 1 1 := by
  refine not_not.2 ⟨![1, 1], fun h0 => by simpa using congrFun h0 0, fun _ => ⟨1, ?_⟩⟩
  rw [boxMat_mulVec]
  ext j
  fin_cases j <;> simp

/-- An invertible matrix of order three, conjugate to the rotation by `2π/3`. -/
def rotThree : Matrix (Fin 2) (Fin 2) ℝ := !![0, -1; 1, -1]

/-- The tuple consisting of `rotThree` is irreducible: an eigenvalue `c` would satisfy
`c² + c + 1 = 0`. -/
theorem tupleIrreducible_rotThree : TupleIrreducible fun _ : Unit => rotThree := by
  rintro ⟨v, hv, h⟩
  obtain ⟨c, hc⟩ := h ()
  have e0 : -v 1 = c * v 0 := by
    simpa [rotThree, Matrix.mulVec, dotProduct, Fin.sum_univ_two] using congrFun hc 0
  have e1 : v 0 + -v 1 = c * v 1 := by
    simpa [rotThree, Matrix.mulVec, dotProduct, Fin.sum_univ_two] using congrFun hc 1
  have h1 : (c ^ 2 + c + 1) * v 1 = 0 := by linear_combination (-1) * e0 - c * e1
  have h2 : v 1 = 0 := (mul_eq_zero.1 h1).resolve_left (by nlinarith [sq_nonneg (c + 1)])
  have h3 : v 0 = 0 := by rw [h2] at e1; linarith
  exact hv (by ext j; fin_cases j <;> simp [h2, h3])

/-- The tuple consisting of `rotThree` is not strongly irreducible: the lines through `(1, 0)`,
`(0, 1)` and `(-1, -1)` are permuted cyclically. -/
theorem not_tupleStronglyIrreducible_rotThree :
    ¬ TupleStronglyIrreducible fun _ : Unit => rotThree := by
  classical
  refine not_not.2 ⟨{![1, 0], ![0, 1], ![-1, -1]}, ⟨_, Finset.mem_insert_self _ _⟩, ?_, ?_⟩
  · intro v hv
    simp only [Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl
    · exact fun h0 => by simpa using congrFun h0 0
    · exact fun h0 => by simpa using congrFun h0 1
    · exact fun h0 => by simpa using congrFun h0 0
  · intro _ v hv
    simp only [Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl
    · refine ⟨![0, 1], by simp, 1, ?_⟩
      ext j
      fin_cases j <;> simp [rotThree, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
    · refine ⟨![-1, -1], by simp, 1, ?_⟩
      ext j
      fin_cases j <;> simp [rotThree, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
    · refine ⟨![1, 0], by simp, 1, ?_⟩
      ext j
      fin_cases j <;> simp [rotThree, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

/-- The tuple consisting of `rotThree` is not diagonal or anti-diagonal in any basis: its trace
is `-1` and its determinant is `1`, an anti-diagonal matrix has trace `0`, and a real diagonal
matrix with determinant `1` has trace of modulus at least `2`. An irreducible and not strongly
irreducible tuple of invertible matrices is therefore not always of the form in item (2) of
`thm:A_classification`; the hypothesis of proximality excludes this tuple. -/
theorem not_simultaneouslyBoxLike_rotThree :
    ¬ SimultaneouslyBoxLike fun _ : Unit => rotThree := by
  rintro ⟨P, hP, hbox, -⟩
  obtain ⟨c, a, b, h⟩ := hbox ()
  have htr := trace_inv_mul_mul hP rotThree
  have hdet := det_inv_mul_mul hP rotThree
  rw [h] at htr hdet
  rcases zmod_two_cases c with rfl | rfl
  · simp only [boxMat_zero, rotThree, Matrix.trace_fin_two_of, Matrix.det_fin_two_of] at htr hdet
    nlinarith [sq_nonneg (a - b)]
  · simp only [boxMat_one, rotThree, Matrix.trace_fin_two_of] at htr
    linarith

/-! ### Box-like tuples -/

namespace System

variable (S : System ι)

/-- `System.Irreducible` is irreducibility of the tuple `(A_i)`. -/
theorem irreducible_iff_tupleIrreducible : S.Irreducible ↔ TupleIrreducible S.mat := Iff.rfl

/-- `System.Proximal` is proximality of the tuple `(A_i)`. -/
theorem proximal_iff_tupleProximal : S.Proximal ↔ TupleProximal S.mat := Iff.rfl

/-- The matrices of a box-like system are invertible. -/
theorem det_mat_ne_zero (i : ι) : (S.mat i).det ≠ 0 := by
  rw [mat]
  rcases zmod_two_cases (S.o i) with h | h <;> rw [h]
  · rw [boxMat_zero, Matrix.det_fin_two_of]
    simpa using ⟨S.a_ne_zero i, S.b_ne_zero i⟩
  · rw [boxMat_one, Matrix.det_fin_two_of]
    simpa using ⟨S.a_ne_zero i, S.b_ne_zero i⟩

/-- A box-like tuple is not strongly irreducible: the union of the two coordinate axes is
invariant under every `A_i` (tex lines 378 to 378, 1463 to 1464 and 505 to 506). -/
theorem not_tupleStronglyIrreducible : ¬ TupleStronglyIrreducible S.mat :=
  not_tupleStronglyIrreducible_of_conj_boxMat (P := 1) (by simp) fun i =>
    ⟨S.o i, S.a i, S.b i, by rw [inv_one, Matrix.one_mul, Matrix.mul_one, mat]⟩

/-- A box-like tuple with an anti-diagonal generator is of the form in item (2) of
`thm:A_classification`, in the standard basis. -/
theorem simultaneouslyBoxLike (h : ∃ i, S.o i = 1) : SimultaneouslyBoxLike S.mat := by
  obtain ⟨i₁, h₁⟩ := h
  refine ⟨1, by simp, fun i => ⟨S.o i, S.a i, S.b i, ?_⟩, i₁, S.a i₁, S.b i₁, ?_⟩
  · rw [inv_one, Matrix.one_mul, Matrix.mul_one, mat]
  · rw [inv_one, Matrix.one_mul, Matrix.mul_one, mat, h₁]

/-- A proximal box-like tuple with an anti-diagonal generator is irreducible, by
`SimultaneouslyBoxLike.tupleIrreducible`. This proves `System.irreducible_of_proximal` without
`thm:box_like_proximal`, and a diagonal generator is not needed. -/
theorem tupleIrreducible_of_proximal (h : ∃ i, S.o i = 1) (hprox : S.Proximal) :
    TupleIrreducible S.mat :=
  (S.simultaneouslyBoxLike h).tupleIrreducible S.det_mat_ne_zero hprox

/-- A proximal box-like tuple with rotations is in case (2) of `thm:A_classification`: it is
irreducible and not strongly irreducible, as stated in the proof of
`prop:ssc_no_overlap_not_pesc` (tex lines 1387 to 1389) and at tex lines 696 to 698. -/
theorem irreducible_and_not_stronglyIrreducible (hrot : S.WithRotations) (hprox : S.Proximal) :
    TupleIrreducible S.mat ∧ ¬ TupleStronglyIrreducible S.mat :=
  ⟨S.tupleIrreducible_of_proximal hrot.2 hprox, S.not_tupleStronglyIrreducible⟩

end System

end BoxLike
