module

/-
Finite subsystems of a box-like system: the combinatorial part of the proof of `thm:main2` in
`sec:dimension_result_proof` (tex lines 3454 to 3515 and 3703 to 3707). A family of words
`w_k`, `k : κ`, of a box-like system `Φ` generates the subsystem `(φ_{w_k})_{k : κ}`, again a
box-like system. When the words have a common length and are distinct, and their planar
matrices are diagonal, the coordinate maps of the subsystem generate a free semigroup as soon
as the projective system of `Φ` has no exact overlaps, and a feasible open set of `Φ` into
which all the words are coded gives unique coding for the subsystem.

* `System.abs_gDeriv_le_one`, `System.abs_gDeriv_lt_one`: `|g_𝐣'| ≤ 1`, with strict
  inequality for a non-empty word.
* `System.subsystem`: the subsystem `(φ_{w_k})_{k : κ}`, with `System.subsystem_mat`,
  `System.subsystem_phi`, `System.subsystem_g`: its matrices, maps and coordinate maps are
  `A_{w_k}`, `φ_{w_k}` and `g` along the paths of `Σ_Z` over `w_k`.
* `flatWords`, `System.subsystem_phiWord`, `System.subsystem_codeWord_gWord`: a word of the
  subsystem is the concatenation of the words `w_k`, with the same map and coordinate maps.
* `flatWords_injective`: concatenation of distinct words of a common positive length is
  injective.
* `System.matWord_eq_boxMat_zero_iff`: `A_𝐢 = diag(a, b)` exactly when `A_𝐢` is diagonal with
  the derivatives of the two paths as entries.
* `System.NoExactOverlaps.simWord_injective`: the coordinate maps of a subsystem of distinct
  diagonal words of a common length generate a free semigroup (tex lines 3523 to 3527).
* `System.subsystem_attractor_subset`, `System.subsystem_attractor_subset_image`: the attractor
  of the subsystem lies in `X`, and in `φ_v(X)` when every word starts with `v`.
* `System.exists_phiWord_image_subset`: a word `v` with `φ_v(X) ⊆ U` for an open set `U`
  meeting `X` (proof of `thm:SOSC_h2_zero`, used at tex lines 3508 to 3510).
* `System.pairwise_disjoint_image_phiWord`, `System.subsystem_future_eq_of_proj_eq`: distinct
  words of equal length map a feasible open set to disjoint sets, so the subsystem of words
  coded into `U` has unique coding (tex lines 3513 to 3515 and 3722 to 3725).
-/
public import BoxLike.Attractor
public import BoxLike.SeparationConditions
public import BoxLike.StrongOpenSetEntropy

@[expose] public section

namespace BoxLike

open Set

namespace System

variable {ι κ : Type*} (S : System ι)

/-! ### Derivatives of words -/

/-- `|g_𝐣'| ≤ 1` for every word. -/
theorem abs_gDeriv_le_one (u : List (ι × ZMod 2)) : |S.gDeriv u| ≤ 1 := by
  induction u with
  | nil => simp
  | cons p u ih =>
    rw [gDeriv_cons, abs_mul]
    calc |S.ratio p| * |S.gDeriv u| ≤ 1 * 1 :=
          mul_le_mul (S.abs_ratio_lt_one p).le ih (abs_nonneg _) zero_le_one
      _ = 1 := one_mul 1

/-- `|g_𝐣'| < 1` for every non-empty word. -/
theorem abs_gDeriv_lt_one {u : List (ι × ZMod 2)} (hu : u ≠ []) : |S.gDeriv u| < 1 := by
  obtain ⟨p, u, rfl⟩ := List.exists_cons_of_ne_nil hu
  rw [gDeriv_cons, abs_mul]
  calc |S.ratio p| * |S.gDeriv u| ≤ |S.ratio p| * 1 :=
        mul_le_mul_of_nonneg_left (S.abs_gDeriv_le_one u) (abs_nonneg _)
    _ = |S.ratio p| := mul_one _
    _ < 1 := S.abs_ratio_lt_one p

/-! ### The subsystem of a family of words -/

/-- The subsystem `(φ_{w_k})_{k : κ}` of `Φ` generated by the non-empty words `w_k` (tex lines
3676 to 3682): the linear part of `φ_{w_k}` is `A_{w_k}`, a diagonal or anti-diagonal matrix
whose entries are the derivatives of `g` along the two paths of `Σ_Z` over `w_k`, and its
translation part is `φ_{w_k}(0)`. -/
def subsystem (w : κ → List ι) (hw : ∀ k, w k ≠ []) : System κ where
  o k := S.oWord (w k)
  a k := S.gDeriv (S.codeWord 0 (w k))
  b k := S.gDeriv (S.codeWord 1 (w k))
  v k := S.phiWord (w k) 0
  a_ne_zero _ := S.gDeriv_ne_zero _
  b_ne_zero _ := S.gDeriv_ne_zero _
  abs_a_lt_one k := S.abs_gDeriv_lt_one fun h =>
    hw k (List.length_eq_zero_iff.1 (by simpa using congrArg List.length h))
  abs_b_lt_one k := S.abs_gDeriv_lt_one fun h =>
    hw k (List.length_eq_zero_iff.1 (by simpa using congrArg List.length h))

variable {w : κ → List ι} {hw : ∀ k, w k ≠ []}

@[simp] theorem subsystem_o (k : κ) : (S.subsystem w hw).o k = S.oWord (w k) := rfl

@[simp] theorem subsystem_a (k : κ) :
    (S.subsystem w hw).a k = S.gDeriv (S.codeWord 0 (w k)) := rfl

@[simp] theorem subsystem_b (k : κ) :
    (S.subsystem w hw).b k = S.gDeriv (S.codeWord 1 (w k)) := rfl

@[simp] theorem subsystem_v (k : κ) : (S.subsystem w hw).v k = S.phiWord (w k) 0 := rfl

/-- The linear part of the `k`-th map of the subsystem is `A_{w_k}`. -/
theorem subsystem_mat (k : κ) : (S.subsystem w hw).mat k = S.matWord (w k) := by
  rw [matWord_eq]; rfl

/-- `coord c (φ_𝐢(z)) = g'_{𝐣} coord (c + o(𝐢)) z + g_𝐣(0)` along the path `𝐣` of `Σ_Z`
over `𝐢` starting on the axis `c`. -/
theorem coord_phiWord_eq (c : ZMod 2) (u : List ι) (z : ℝ × ℝ) :
    coord c (S.phiWord u z) =
      S.gDeriv (S.codeWord c u) * coord (c + S.oWord u) z + S.gWord (S.codeWord c u) 0 := by
  rw [coord_phiWord, gWord_apply]

/-- The `k`-th map of the subsystem is `φ_{w_k}`. -/
theorem subsystem_phi (k : κ) : (S.subsystem w hw).phi k = S.phiWord (w k) := by
  funext z
  have h0 : ∀ c : ZMod 2, coord c (0 : ℝ × ℝ) = 0 := fun c => by
    rcases zmod_two_cases c with rfl | rfl <;> rfl
  refine Prod.ext ?_ ?_
  · show S.gDeriv (S.codeWord 0 (w k)) * coord (S.oWord (w k)) z +
      coord 0 (S.phiWord (w k) 0) = coord 0 (S.phiWord (w k) z)
    simp only [coord_phiWord_eq, h0, mul_zero, zero_add]
  · show S.gDeriv (S.codeWord 1 (w k)) * coord (S.oWord (w k) + 1) z +
      coord 1 (S.phiWord (w k) 0) = coord 1 (S.phiWord (w k) z)
    simp only [coord_phiWord_eq, h0, mul_zero, zero_add]
    rw [add_comm (1 : ZMod 2)]

/-- The ratio of the symbol `(k, c)` of the projective system of the subsystem is the
derivative of `g` along the path of `Σ_Z` over `w_k` starting on the axis `c`. -/
theorem subsystem_ratio (k : κ) (c : ZMod 2) :
    (S.subsystem w hw).ratio (k, c) = S.gDeriv (S.codeWord c (w k)) := by
  rcases zmod_two_cases c with rfl | rfl <;> rfl

/-- The translation of the symbol `(k, c)` of the projective system of the subsystem is
`g_𝐣(0)` along the path `𝐣` of `Σ_Z` over `w_k` starting on the axis `c`. -/
theorem subsystem_trans (k : κ) (c : ZMod 2) :
    (S.subsystem w hw).trans (k, c) = S.gWord (S.codeWord c (w k)) 0 := by
  have h0 : ∀ c : ZMod 2, coord c (0 : ℝ × ℝ) = 0 := fun c => by
    rcases zmod_two_cases c with rfl | rfl <;> rfl
  change coord c (S.phiWord (w k) 0) = _
  rw [coord_phiWord_eq, h0, mul_zero, zero_add]

/-- The coordinate map of the symbol `(k, c)` of the subsystem is `g_𝐣` along the path `𝐣` of
`Σ_Z` over `w_k` starting on the axis `c`. -/
theorem subsystem_g (k : κ) (c : ZMod 2) :
    (S.subsystem w hw).g (k, c) = S.gWord (S.codeWord c (w k)) := by
  funext t
  change (S.subsystem w hw).ratio (k, c) * t + (S.subsystem w hw).trans (k, c) = _
  rw [subsystem_ratio, subsystem_trans, S.gWord_apply (S.codeWord c (w k)) t]

/-! ### Words of the subsystem -/

end System

/-- The concatenation `w_{k_0} ⋯ w_{k_{n-1}}` of the words of a family over a word of `κ`. -/
def flatWords {ι κ : Type*} (w : κ → List ι) (u : List κ) : List ι := (u.map w).flatten

@[simp] theorem flatWords_nil {ι κ : Type*} (w : κ → List ι) : flatWords w [] = [] := rfl

@[simp] theorem flatWords_cons {ι κ : Type*} (w : κ → List ι) (k : κ) (u : List κ) :
    flatWords w (k :: u) = w k ++ flatWords w u := by
  simp [flatWords]

theorem flatWords_append {ι κ : Type*} (w : κ → List ι) (u u' : List κ) :
    flatWords w (u ++ u') = flatWords w u ++ flatWords w u' := by
  simp [flatWords]

/-- The concatenation of words of a common length `n` has length `n` times the number of
words. -/
theorem length_flatWords {ι κ : Type*} {w : κ → List ι} {n : ℕ} (hlen : ∀ k, (w k).length = n)
    (u : List κ) : (flatWords w u).length = n * u.length := by
  induction u with
  | nil => simp
  | cons k u ih => simp only [flatWords_cons, List.length_append, ih, hlen, List.length_cons]; ring

/-- Concatenation of distinct words of a common positive length is injective. -/
theorem flatWords_injective {ι κ : Type*} {w : κ → List ι} {n : ℕ} (hn : 0 < n)
    (hlen : ∀ k, (w k).length = n) (hinj : Function.Injective w) :
    Function.Injective (flatWords w) := by
  intro u u' h
  induction u generalizing u' with
  | nil =>
    cases u' with
    | nil => rfl
    | cons k u' =>
      have := congrArg List.length h
      rw [length_flatWords hlen, length_flatWords hlen] at this
      simp at this
      omega
  | cons k u ih =>
    cases u' with
    | nil =>
      have := congrArg List.length h
      rw [length_flatWords hlen, length_flatWords hlen] at this
      simp at this
      omega
    | cons k' u' =>
      rw [flatWords_cons, flatWords_cons] at h
      have hk : w k = w k' := by
        have h1 := congrArg (List.take n) h
        rwa [List.take_append_of_le_length (hlen k).ge, List.take_append_of_le_length (hlen k').ge,
          List.take_of_length_le (hlen k).le, List.take_of_length_le (hlen k').le] at h1
      have hu : flatWords w u = flatWords w u' := by
        have h1 := congrArg (List.drop n) h
        rwa [List.drop_append_of_le_length (hlen k).ge,
          List.drop_append_of_le_length (hlen k').ge, List.drop_of_length_le (hlen k).le,
          List.drop_of_length_le (hlen k').le, List.nil_append, List.nil_append] at h1
      rw [hinj hk, ih hu]

namespace System

variable {ι κ : Type*} (S : System ι) {w : κ → List ι} {hw : ∀ k, w k ≠ []}

/-- `φ_{𝐢𝐣} = φ_𝐢 ∘ φ_𝐣`. -/
theorem phiWord_append' (u u' : List ι) : S.phiWord (u ++ u') = S.phiWord u ∘ S.phiWord u' := by
  induction u with
  | nil => rfl
  | cons i u ih => simp [ih, Function.comp_assoc]

/-- The map of a word of the subsystem is the map of the concatenated word of `Φ`. -/
theorem subsystem_phiWord (u : List κ) :
    (S.subsystem w hw).phiWord u = S.phiWord (flatWords w u) := by
  induction u with
  | nil => rfl
  | cons k u ih => rw [phiWord_cons, subsystem_phi, ih, flatWords_cons, phiWord_append']

/-- The parity of a word of the subsystem is that of the concatenated word. -/
theorem subsystem_oWord (u : List κ) : (S.subsystem w hw).oWord u = S.oWord (flatWords w u) := by
  induction u with
  | nil => rfl
  | cons k u ih => rw [oWord_cons, subsystem_o, ih, flatWords_cons, oWord_append]

/-- The coordinate map `g` along the path of the subsystem's `Σ_Z` over a word `u` starting on
the axis `c` is `g` along the path of `Σ_Z` over the concatenated word. -/
theorem subsystem_codeWord_gWord (c : ZMod 2) (u : List κ) :
    (S.subsystem w hw).gWord ((S.subsystem w hw).codeWord c u) =
      S.gWord (S.codeWord c (flatWords w u)) := by
  induction u generalizing c with
  | nil => rfl
  | cons k u ih =>
    rw [codeWord_cons, gWord_cons, subsystem_g, ih, flatWords_cons, codeWord_append,
      gWord_append, subsystem_o]

/-! ### Diagonal words -/

/-- `A_𝐢 = diag(a, b)` exactly when `𝐢` has an even number of anti-diagonal generators and `a`,
`b` are the derivatives of `g` along the two paths of `Σ_Z` over `𝐢`. -/
theorem matWord_eq_boxMat_zero_iff (u : List ι) (a b : ℝ) :
    S.matWord u = boxMat 0 a b ↔
      S.oWord u = 0 ∧ S.gDeriv (S.codeWord 0 u) = a ∧ S.gDeriv (S.codeWord 1 u) = b := by
  rw [matWord_eq]
  constructor
  · intro h
    rcases zmod_two_cases (S.oWord u) with h0 | h1
    · rw [h0, boxMat_zero, boxMat_zero] at h
      refine ⟨h0, ?_, ?_⟩
      · simpa using congrFun (congrFun h 0) 0
      · simpa using congrFun (congrFun h 1) 1
    · rw [h1, boxMat_one, boxMat_zero] at h
      have := congrFun (congrFun h 0) 1
      simp at this
      exact absurd this (S.gDeriv_ne_zero _)
  · rintro ⟨h0, ha, hb⟩
    rw [h0, ha, hb]

/-- The composition of the coordinate maps of the subsystem over a word `u`, on the axis `c`,
is `g` along the path of `Σ_Z` over the concatenated word, when all the words `w_k` have an
even number of anti-diagonal generators. -/
theorem simWord_subsystem_eq (c : ZMod 2) (hdiag : ∀ k, S.oWord (w k) = 0) (u : List κ) :
    simWord (fun k => S.gDeriv (S.codeWord c (w k))) (fun k => S.gWord (S.codeWord c (w k)) 0)
        u = S.gWord (S.codeWord c (flatWords w u)) := by
  induction u with
  | nil => rfl
  | cons k u ih =>
    rw [simWord_cons, ih, flatWords_cons, codeWord_append, gWord_append, hdiag, add_zero]
    funext t
    simp only [Function.comp_apply]
    exact (S.gWord_apply (S.codeWord c (w k)) _).symm

/-- Two words over `ι` with the same path of `Σ_Z` from the axis `c` are equal. -/
theorem codeWord_injective (c : ZMod 2) : Function.Injective (S.codeWord c) := by
  intro u u' h
  have : ∀ (c : ZMod 2) (u : List ι), (S.codeWord c u).map Prod.fst = u := by
    intro c u
    induction u generalizing c with
    | nil => rfl
    | cons i u ih => simp [ih]
  rw [← this c u, ← this c u', h]

/-- The coordinate maps of a subsystem of distinct diagonal words of a common positive length
generate a free semigroup when the projective system of `Φ` has no exact overlaps (tex lines
3703 to 3707): a composition of subsystem maps is the map of a concatenation of distinct
equal-length words of `Ψ` on the same axis. -/
theorem NoExactOverlaps.simWord_injective (hfree : S.NoExactOverlaps) (c : ZMod 2)
    (hdiag : ∀ k, S.oWord (w k) = 0) {n : ℕ} (hn : 0 < n) (hlen : ∀ k, (w k).length = n)
    (hinj : Function.Injective w) :
    Function.Injective
      (simWord (fun k => S.gDeriv (S.codeWord c (w k))) (fun k => S.gWord (S.codeWord c (w k)) 0)) := by
  intro u u' h
  rw [simWord_subsystem_eq S c hdiag, simWord_subsystem_eq S c hdiag] at h
  exact flatWords_injective hn hlen hinj
    (S.codeWord_injective c ((S.noExactOverlaps_iff.1 hfree) h))

/-! ### The attractor of the subsystem -/

/-- `φ_𝐢(X) ⊆ X` for every word `𝐢`. -/
theorem phiWord_image_attractor_subset [Finite ι] (u : List ι) :
    S.phiWord u '' S.attractor ⊆ S.attractor := by
  induction u with
  | nil => simp
  | cons i u ih =>
    rw [phiWord_cons, image_comp]
    exact (image_mono ih).trans (S.image_attractor_subset i)

/-- The attractor of a subsystem lies in `X` (tex lines 3558 to 3559). -/
theorem subsystem_attractor_subset [Finite ι] [Nonempty ι] [Finite κ] :
    (S.subsystem w hw).attractor ⊆ S.attractor :=
  (S.subsystem w hw).attractor_subset_of_invariant S.isCompact_attractor S.attractor_nonempty
    fun k => by rw [subsystem_phi]; exact S.phiWord_image_attractor_subset (w k)

/-- When every word of the subsystem starts with `v`, the attractor of the subsystem lies in
`φ_v(X)` (tex lines 3511 to 3513). -/
theorem subsystem_attractor_subset_image [Finite ι] [Nonempty ι] [Finite κ] {v : List ι}
    (hv : ∀ k, ∃ u, w k = v ++ u) :
    (S.subsystem w hw).attractor ⊆ S.phiWord v '' S.attractor := by
  rintro _ ⟨x, rfl⟩
  obtain ⟨r, M, hT⟩ := (S.subsystem w hw).exists_bounds
  rw [hT.proj_eq, subsystem_phi]
  obtain ⟨u, hu⟩ := hv (x 0)
  rw [hu, phiWord_append', Function.comp_apply]
  exact ⟨_, S.phiWord_image_attractor_subset u
    ⟨_, S.subsystem_attractor_subset ⟨shift 1 x, rfl⟩, rfl⟩, rfl⟩

/-- A word `v` with `φ_v(X) ⊆ U`, for an open set `U` meeting `X` (proof of
`thm:SOSC_h2_zero`, tex lines 3335 to 3336). -/
theorem exists_phiWord_image_subset [Finite ι] {U : Set (ℝ × ℝ)} (hU : IsOpen U)
    (hne : (U ∩ S.attractor).Nonempty) : ∃ v : List ι, S.phiWord v '' S.attractor ⊆ U := by
  obtain ⟨x, n, -, hcyl⟩ := S.exists_cylinder_proj_mem hU hne
  obtain ⟨r, M, hS⟩ := S.exists_bounds
  refine ⟨futureWord x n, ?_⟩
  rintro _ ⟨_, ⟨y, rfl⟩, rfl⟩
  let z : ℤ → ι := fun k => if 0 ≤ k ∧ k < n then x k else y (k - n)
  have hz : z ∈ cylinder (block n x) := fun k => by
    have hk := k.isLt
    simp only [z, block_apply]
    split_ifs with h
    · rfl
    · exact absurd ⟨by omega, by omega⟩ h
  have hfut : futureWord z n = futureWord x n :=
    futureWord_eq_of_mem_cylinder hz
  have hshift : S.proj (shift n z) = S.proj y := by
    refine S.proj_congr fun k => ?_
    simp only [z, shift_apply]
    split_ifs with h
    · exact absurd h.2 (by omega)
    · congr 1; omega
  have := hcyl z hz
  rwa [hS.proj_eq_phiWord z n, hfut, hshift] at this

/-! ### Unique coding of a subsystem inside a feasible open set -/

/-- Distinct words of equal length map a feasible open set to disjoint sets. -/
theorem pairwise_disjoint_image_phiWord {U : Set (ℝ × ℝ)} (hsub : ∀ i, S.phi i '' U ⊆ U)
    (hdisj : Pairwise fun i j => Disjoint (S.phi i '' U) (S.phi j '' U)) (u u' : List ι)
    (hlen : u.length = u'.length) (hne : u ≠ u') :
    Disjoint (S.phiWord u '' U) (S.phiWord u' '' U) := by
  induction u generalizing u' with
  | nil =>
    cases u' with
    | nil => exact absurd rfl hne
    | cons => simp at hlen
  | cons i u ih =>
    cases u' with
    | nil => simp at hlen
    | cons j u' =>
      rw [phiWord_cons, phiWord_cons, image_comp, image_comp]
      by_cases hij : i = j
      · subst hij
        have hne' : u ≠ u' := fun h => hne (by rw [h])
        have hlen' : u.length = u'.length := by simpa using hlen
        exact (Set.disjoint_image_iff (S.injective_phi i)).2 (ih u' hlen' hne')
      · exact (hdisj hij).mono
          (image_mono (image_subset_iff.2 fun z hz => S.phiWord_mem hsub u hz))
          (image_mono (image_subset_iff.2 fun z hz => S.phiWord_mem hsub u' hz))

/-- Unique coding for a subsystem of distinct words of equal length coded into a feasible open
set `U` (tex lines 3513 to 3515 and 3722 to 3725): if `π(𝐣) = π(𝐢)` for the subsystem then
`𝐣^+ = 𝐢^+`. The proof is that of `thm:SOSC_h2_zero`, `future_eq_of_proj_eq`, for the
subsystem and the open set `U`, whose images under distinct subsystem maps are disjoint. -/
theorem subsystem_future_eq_of_proj_eq [Finite κ] {U : Set (ℝ × ℝ)} (hU : IsOpen U)
    (hne : U.Nonempty) (hsub : ∀ i, S.phi i '' U ⊆ U)
    (hdisj : Pairwise fun i j => Disjoint (S.phi i '' U) (S.phi j '' U))
    (hlen : ∀ k k', (w k).length = (w k').length) (hinj : Function.Injective w)
    (hatt : (S.subsystem w hw).attractor ⊆ U) {x y : ℤ → κ}
    (hxy : (S.subsystem w hw).proj y = (S.subsystem w hw).proj x) (k : ℕ) : y k = x k := by
  refine (S.subsystem w hw).future_eq_of_proj_eq hU hne ?_ ?_ (fun k => hatt ⟨_, rfl⟩) hxy k
  · intro k
    rw [subsystem_phi]
    exact image_subset_iff.2 fun z hz => S.phiWord_mem hsub (w k) hz
  · intro k k' hkk'
    rw [subsystem_phi, subsystem_phi]
    exact S.pairwise_disjoint_image_phiWord hsub hdisj _ _ (hlen k k') (hinj.ne hkk')

end System

end BoxLike
